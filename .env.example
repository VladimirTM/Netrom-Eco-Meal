# Copy this file to `.env` (gitignored, never commit it) in the same directory as
# docker-compose.test.yml — `docker compose` reads it automatically for ${VAR} substitution.

# A free Stripe test-mode secret key (sk_test_...) from https://dashboard.stripe.com/test/apikeys.
# No live/production key is ever needed for this app. Leave empty/unset and checkout shows a
# friendly "payments aren't configured yet" error instead of crashing.
STRIPE_SECRET_KEY=

# Only matters past local dev/demo use. docker-compose.test.yml falls back to a committed,
# clearly-labeled dev-only value (also what Backend/NetromEcoMeal.Api/appsettings.Development.json
# ships) when this is unset, which is fine for `docker compose -f docker-compose.test.yml up`.
# Generate a real 32+ character secret for anything beyond that: `openssl rand -base64 32`.
JWT_KEY=
