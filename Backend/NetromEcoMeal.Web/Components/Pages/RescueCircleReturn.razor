@page "/circles/return"
@layout EmptyLayout
@using Microsoft.AspNetCore.Authorization
@using NetromEcoMeal.Constants
@using NetromEcoMeal.Controllers
@using NetromEcoMeal.Services.Interfaces
@rendermode InteractiveServer
@inject RescueCircleController RescueCircleController
@attribute [Authorize(Roles = AppRoles.Customer)]

<PageTitle>Rescue Circle payment — Eco Meal</PageTitle>

<div class="login-page">
    <div class="login-card">
        <div class="login-brand">
            <img src="logo.png" alt="Eco Meal" class="login-logo"/>
            <div>
                <div class="login-brand-name">Eco Meal</div>
                <div class="login-brand-sub">Surplus food, rescued</div>
            </div>
        </div>

        @if (_loading)
        {
            <div class="cart-confirmation">
                <div class="spinner-border text-primary mb-3" role="status">
                    <span class="visually-hidden">Confirming payment...</span>
                </div>
                <p class="mb-0">Confirming your share…</p>
            </div>
        }
        else if (_success)
        {
            <div class="cart-confirmation">
                <i class="bi bi-check-circle-fill"></i>
                <h3>Your share is paid</h3>
                @if (_summary is not null && _summary.PaidCount == _summary.ParticipantCount)
                {
                    <p>Everyone's paid — @_summary.BusinessName will confirm the order soon.</p>
                }
                else if (_summary is not null)
                {
                    <p>@_summary.PaidCount of @_summary.ParticipantCount people have paid so far. Share the link so the rest can chip in.</p>
                }
                <a class="btn btn-primary w-100 py-2 fw-semibold" href="/circles/@Circle">View the Rescue Circle</a>
            </div>
        }
        else
        {
            <h1 class="login-heading">Payment couldn't be confirmed</h1>
            <div class="alert alert-danger py-2 small mb-3" role="alert">@_message</div>
            <a class="btn btn-primary w-100 py-2 fw-semibold" href="/circles/@Circle">Back to the Rescue Circle</a>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "circle")]
    public Guid? Circle { get; set; }

    [SupplyParameterFromQuery(Name = "participant")]
    public Guid? Participant { get; set; }

    [SupplyParameterFromQuery(Name = "session_id")]
    public string? SessionId { get; set; }

    private bool _loading = true;
    private bool _success;
    private string _message = "This payment link is invalid.";
    private RescueCircleSummary? _summary;

    protected override async Task OnInitializedAsync()
    {
        if (Circle is null || Participant is null || string.IsNullOrWhiteSpace(SessionId))
        {
            _loading = false;
            return;
        }

        var result = await RescueCircleController.CompleteShareCheckoutAsync(Circle.Value, Participant.Value, SessionId);

        if (result.Value is { Success: true } completion)
        {
            _success = true;
            _summary = completion.Summary;
        }
        else if (result.Value is not null)
        {
            _message = result.Value.Message;
        }

        _loading = false;
    }
}
