@page "/circles/{CircleId:guid}"
@layout PublicLayout
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Mvc
@using NetromEcoMeal.Constants
@using NetromEcoMeal.Controllers
@using NetromEcoMeal.Services
@using NetromEcoMeal.Services.Interfaces
@rendermode InteractiveServer
@inject RescueCircleController RescueCircleController
@inject ICurrentUser CurrentUserAccessor
@inject NavigationManager Navigation
@attribute [Authorize(Roles = AppRoles.Customer)]

<PageTitle>Rescue Circle — Eco Meal</PageTitle>

<section class="orders-hero">
    <div class="orders-hero-inner">
        <span class="orders-hero-eyebrow"><i class="bi bi-people"></i> Rescue Circle</span>
        @if (_summary is not null)
        {
            <h1 class="orders-hero-title">@_summary.BusinessName</h1>
            <p class="orders-hero-sub">Splitting @_summary.TotalAmount.ToString("C") across @_summary.ParticipantCount people.</p>
        }
        else
        {
            <h1 class="orders-hero-title">Rescue Circle</h1>
        }
    </div>
</section>

<section class="orders-list-section" style="max-width: 640px;">
    @if (_loading)
    {
        <div class="d-flex justify-content-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (_notFound)
    {
        <NotFoundPanel Title="Rescue Circle not found" Message="This Rescue Circle no longer exists." BackHref="/" BackLabel="Back to browsing"/>
    }
    else if (_summary is not null)
    {
        @if (_error is not null)
        {
            <div class="alert alert-danger py-2 small mb-3" role="alert">@_error</div>
        }
        @if (_message is not null)
        {
            <div class="alert alert-success py-2 small mb-3" role="alert">@_message</div>
        }

        <div class="card mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="badge @StatusBadgeClass">@StatusLabel</span>
                    <span class="text-muted small">@_summary.JoinedCount of @_summary.ParticipantCount joined · @_summary.PaidCount paid</span>
                </div>
                <div class="progress mb-3" style="height: 8px;">
                    <div class="progress-bar bg-success" style="width:@(_summary.ParticipantCount == 0 ? 0 : _summary.PaidCount * 100 / _summary.ParticipantCount)%"></div>
                </div>

                @if (_detail is not null)
                {
                    <ul class="list-group list-group-flush mb-3">
                        @foreach (var p in _detail.Participants)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <span>
                                    @p.UserName
                                    @if (p.IsOrganizer)
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary ms-1">Organizer</span>
                                    }
                                </span>
                                <span class="d-flex align-items-center gap-2">
                                    <span class="text-muted small">@p.ShareAmount.ToString("C")</span>
                                    @if (p.RefundedAt is not null)
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary"><i class="bi bi-arrow-counterclockwise"></i> Refunded</span>
                                    }
                                    else if (p.PaidAt is not null)
                                    {
                                        <span class="badge bg-success-subtle text-success"><i class="bi bi-check-circle"></i> Paid</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning"><i class="bi bi-hourglass-split"></i> Owes</span>
                                    }
                                </span>
                            </li>
                        }
                    </ul>
                }

                @if (_summary.Status == RescueCircleStatuses.Cancelled)
                {
                    <p class="text-muted small mb-0">This Rescue Circle was cancelled — anyone who'd paid was refunded.</p>
                }
                else if (_summary.PaidCount == _summary.ParticipantCount)
                {
                    <p class="text-success small mb-0"><i class="bi bi-check-circle-fill"></i> Fully paid — waiting for @_summary.BusinessName to confirm the order.</p>
                }
                else if (MyParticipant is { PaidAt: not null })
                {
                    <p class="text-muted small mb-2">You've paid your @MyParticipant!.ShareAmount.ToString("C") share — waiting on @(_summary.ParticipantCount - _summary.PaidCount) more.</p>
                    @if (!MyParticipant!.IsOrganizer)
                    {
                        <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@_busy" @onclick="LeaveAsync">Leave &amp; get refunded</button>
                    }
                }
                else if (MyParticipant is not null)
                {
                    <button type="button" class="btn btn-primary w-100 py-2" disabled="@_busy" @onclick="JoinOrPayAsync">
                        @if (_busy) { <span class="spinner-border spinner-border-sm me-2"></span> }
                        Pay my @MyParticipant!.ShareAmount.ToString("C") share
                    </button>
                    @if (!MyParticipant!.IsOrganizer)
                    {
                        <button type="button" class="btn btn-outline-secondary btn-sm w-100 mt-2" disabled="@_busy" @onclick="LeaveAsync">Leave this circle</button>
                    }
                }
                else if (_summary.JoinedCount < _summary.ParticipantCount)
                {
                    <button type="button" class="btn btn-primary w-100 py-2" disabled="@_busy" @onclick="JoinOrPayAsync">
                        @if (_busy) { <span class="spinner-border spinner-border-sm me-2"></span> }
                        Join &amp; pay my @_summary.ShareAmount.ToString("C") share
                    </button>
                }
                else
                {
                    <p class="text-muted small mb-0">This Rescue Circle is full.</p>
                }

                @if (_summary.IsMine && _detail?.OrganizerId is not null)
                {
                    <hr/>
                    <p class="text-muted small mb-0">
                        <i class="bi bi-link-45deg"></i> Share this page's link to invite people.
                    </p>
                }
            </div>
        </div>

        <a href="/orders" class="btn btn-link px-0">Back to my orders</a>
    }
</section>

@code {
    [Parameter] public Guid CircleId { get; set; }

    private bool _loading = true;
    private bool _notFound;
    private bool _busy;
    private string? _error;
    private string? _message;
    private RescueCircleSummary? _summary;
    private RescueCircleDetail? _detail;

    private RescueCircleParticipantView? MyParticipant => _detail?.Participants.FirstOrDefault(p => p.UserId == _myUserId);
    private string? _myUserId;

    private string StatusLabel => _summary?.Status == RescueCircleStatuses.Cancelled ? "Cancelled"
        : _summary?.PaidCount == _summary?.ParticipantCount ? "Fully paid" : "Collecting payments";

    private string StatusBadgeClass => _summary?.Status == RescueCircleStatuses.Cancelled ? "bg-secondary-subtle text-secondary"
        : _summary?.PaidCount == _summary?.ParticipantCount ? "bg-success-subtle text-success" : "bg-warning-subtle text-warning";

    protected override async Task OnInitializedAsync()
    {
        (_, _myUserId) = await CurrentUserAccessor.GetCurrentUserAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var detailResult = await RescueCircleController.GetDetailAsync(CircleId);
        if (detailResult.Value is not null)
        {
            _detail = detailResult.Value;
            _summary = _detail.Summary;
        }
        else if (detailResult.Result is ConflictObjectResult)
        {
            // Not the organizer/a participant (or the circle doesn't exist) — fall back to the
            // public summary anyone signed in can see, clearing stale detail (e.g. right after
            // leaving) so its participant list doesn't linger once we can't see it anymore.
            _detail = null;
            var summaryResult = await RescueCircleController.GetSummaryAsync(CircleId);
            if (summaryResult.Value is not null)
                _summary = summaryResult.Value;
            else
                _notFound = true;
        }

        _loading = false;
    }

    private async Task JoinOrPayAsync()
    {
        _busy = true;
        _error = null;

        var result = await RescueCircleController.JoinOrPayAsync(CircleId);
        if (result.Result is ConflictObjectResult conflict)
        {
            _error = conflict.Value as string ?? "We couldn't process that — please try again.";
            _busy = false;
            return;
        }

        Navigation.NavigateTo(result.Value!, forceLoad: true);
    }

    private async Task LeaveAsync()
    {
        _busy = true;
        _error = null;

        var result = await RescueCircleController.LeaveCircleAsync(CircleId);
        if (result is ConflictObjectResult conflict)
        {
            _error = conflict.Value as string ?? "We couldn't process that — please try again.";
            _busy = false;
            return;
        }

        _message = "You've left this Rescue Circle.";
        await LoadAsync();
        _busy = false;
    }
}
