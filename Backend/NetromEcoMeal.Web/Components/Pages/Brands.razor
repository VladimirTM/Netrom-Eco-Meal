@page "/brands"
@layout PublicLayout
@using NetromEcoMeal.Controllers
@using NetromEcoMeal.Entities
@rendermode InteractiveServer
@inject BrandController BrandController

<PageTitle>Brands — Eco Meal</PageTitle>

<div class="container py-4">
    <div class="mb-4">
        <h1 class="h3 fw-bold mb-1">Brands</h1>
        <p class="text-muted small mb-0">Chains with more than one location on Eco Meal — favorite the brand and every branch counts toward it.</p>
    </div>

    @if (_brands is null)
    {
        <div class="d-flex justify-content-center py-5">
            <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div>
        </div>
    }
    else if (_brands.Count == 0)
    {
        <p class="text-muted">No brands yet — an admin can group locations into one from the "Kitchen &amp; Package Types" page.</p>
    }
    else
    {
        <div class="row g-3">
            @foreach (var brand in _brands)
            {
                <div class="col-sm-6 col-lg-4" @key="brand.Id">
                    <a href="@($"/brands/{brand.Id}")" class="text-decoration-none">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body">
                                <h2 class="h6 fw-bold mb-1 text-body">@brand.Name</h2>
                                @if (!string.IsNullOrWhiteSpace(brand.Description))
                                {
                                    <p class="text-muted small mb-2">@brand.Description</p>
                                }
                                <span class="text-muted small"><i class="bi bi-geo-alt me-1"></i>@brand.Businesses.Count location@(brand.Businesses.Count == 1 ? "" : "s")</span>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<Brand>? _brands;

    protected override async Task OnInitializedAsync()
    {
        // Only brands with at least one location are worth showing on a public browse page.
        var all = (await BrandController.GetAllAsync()).Value ?? [];
        _brands = all.Where(b => b.Businesses.Count > 0).ToList();
    }
}
