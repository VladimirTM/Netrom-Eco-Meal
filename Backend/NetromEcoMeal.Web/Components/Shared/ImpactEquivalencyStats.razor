@using NetromEcoMeal.Constants

@* Turns a raw kg-saved figure into km-not-driven/liters-of-water via Constants.ImpactEquivalency,
   so the order receipt (OrderDetailModal) and the /impact page always agree on the conversion. *@
@if (KgSaved > 0)
{
    <div class="impact-equivalency">
        <span class="impact-equivalency-item"><i class="bi bi-car-front"></i> ~@ImpactEquivalency.KmNotDriven(KgSaved).ToString("0") km not driven</span>
        <span class="impact-equivalency-item"><i class="bi bi-droplet"></i> ~@ImpactEquivalency.LitersOfWater(KgSaved).ToString("N0") L of water saved</span>
    </div>
}

@code {
    [Parameter, EditorRequired] public decimal KgSaved { get; set; }
}
