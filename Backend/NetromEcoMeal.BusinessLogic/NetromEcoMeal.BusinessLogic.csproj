<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetromEcoMeal.DataAccess\NetromEcoMeal.DataAccess.csproj" />
  </ItemGroup>

  <!--
    Phase 2 moved every Blazor-circuit-specific dependency (SignInManager's cookie calls,
    IJSRuntime, AuthenticationStateProvider) out of this project — see ICurrentUser, AuthService
    and the architecture test below. This FrameworkReference stays regardless: BackgroundService
    (the sweep services), IWebHostEnvironment (ImageUploadService) and the Identity.Data DTOs
    (LoginRequest/RegisterRequest) are plain ASP.NET Core / generic-host types, not Blazor ones —
    Phase 3's Api host is itself an ASP.NET Core host and needs this project to build against the
    same shared framework.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.9.0" />
    <PackageReference Include="Stripe.net" Version="52.2.0" />
    <PackageReference Include="WebPush" Version="1.0.13" />
  </ItemGroup>

</Project>
