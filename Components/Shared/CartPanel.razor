@using Microsoft.AspNetCore.Mvc
@using Netrom_Eco_Meal.Constants
@using Netrom_Eco_Meal.Controllers
@using Netrom_Eco_Meal.Services
@using Netrom_Eco_Meal.Services.Interfaces
@implements IDisposable
@inject CartService CartService
@inject PaymentController PaymentController
@inject RescueCircleController RescueCircleController
@inject NavigationManager Navigation

@if (IsOpen)
{
    <div class="cart-backdrop" @onclick="Close"></div>
    <aside class="cart-panel">
        <div class="cart-panel-header">
            <div>
                <h2 class="cart-panel-title">Your basket</h2>
                @if (CartService.BusinessName is not null)
                {
                    <p class="cart-panel-subtitle"><i class="bi bi-shop"></i> @CartService.BusinessName</p>
                }
            </div>
            <button type="button" class="cart-panel-close" @onclick="Close" aria-label="Close basket">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        @if (CartService.Items.Count == 0)
        {
            <div class="cart-panel-body cart-empty">
                <div class="em-empty-icon"><i class="bi bi-basket2"></i></div>
                <p class="mb-1">Your basket is empty.</p>
                <span class="text-muted small">Add a package from a kitchen to get started.</span>
            </div>
        }
        else
        {
            <div class="cart-panel-body">
                @if (_error is not null)
                {
                    <div class="alert alert-danger py-2 small mb-3">@_error</div>
                }
                @foreach (var item in CartService.Items)
                {
                    <div class="cart-line">
                        <div class="cart-line-info">
                            <div class="cart-line-name">@item.Package.Name</div>
                            <div class="cart-line-price">@item.Package.Price.ToString("C") each</div>
                        </div>
                        <div class="cart-line-controls">
                            <button type="button" class="cart-step-btn" @onclick="() => CartService.SetQuantityAsync(item.Package.Id, item.Quantity - 1)">
                                <i class="bi bi-dash"></i>
                            </button>
                            <span class="cart-line-qty">@item.Quantity</span>
                            <button type="button" class="cart-step-btn" disabled="@(item.Quantity >= item.Package.Quantity)"
                                    @onclick="() => CartService.SetQuantityAsync(item.Package.Id, item.Quantity + 1)">
                                <i class="bi bi-plus"></i>
                            </button>
                        </div>
                        <button type="button" class="cart-line-remove" title="Remove" @onclick="() => CartService.RemoveAsync(item.Package.Id)">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                }
            </div>

            <div class="cart-panel-footer">
                <div class="cart-panel-total">
                    <span>Total</span>
                    <span class="cart-panel-total-value">@CartService.TotalPrice.ToString("C")</span>
                </div>

                <div class="mb-2">
                    <label for="cart-logistics-note" class="form-label small text-muted mb-1">Note for the business (optional)</label>
                    <textarea id="cart-logistics-note" class="form-control form-control-sm" rows="2"
                              placeholder="Running late, can't carry it to my car, will call when I arrive…"
                              maxlength="@OrderLogistics.MaxNoteLength" @bind="_logisticsNote"></textarea>
                </div>

                @if (!_splitOpen)
                {
                    <button type="button" class="btn btn-primary w-100 py-2 mb-2" disabled="@_placing" @onclick="StartCheckoutAsync">
                        @if (_placing)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        }
                        else
                        {
                            <i class="bi bi-credit-card me-2"></i>
                        }
                        Pay &amp; place order
                    </button>
                    <button type="button" class="btn btn-link w-100 py-0 text-decoration-none small" @onclick="() => _splitOpen = true">
                        <i class="bi bi-people me-1"></i>Split this with friends instead
                    </button>
                }
                else
                {
                    <div class="rescue-circle-starter mb-2">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="small fw-semibold"><i class="bi bi-people me-1"></i>Rescue Circle</span>
                            <button type="button" class="btn-close btn-sm" aria-label="Close" @onclick="() => _splitOpen = false"></button>
                        </div>
                        <p class="text-muted small mb-2">Split the @CartService.TotalPrice.ToString("C") total evenly — everyone pays their own share, and you'll get a link to invite them.</p>
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <button type="button" class="cart-step-btn" disabled="@(_participantCount <= RescueCircles.MinParticipants)" @onclick="() => _participantCount--">
                                <i class="bi bi-dash"></i>
                            </button>
                            <span class="cart-line-qty">@_participantCount people</span>
                            <button type="button" class="cart-step-btn" disabled="@(_participantCount >= RescueCircles.MaxParticipants)" @onclick="() => _participantCount++">
                                <i class="bi bi-plus"></i>
                            </button>
                            <span class="text-muted small ms-auto">≈ @((CartService.TotalPrice / _participantCount).ToString("C")) each</span>
                        </div>
                        <button type="button" class="btn btn-primary w-100 py-2" disabled="@_placing" @onclick="StartCircleAsync">
                            @if (_placing)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            }
                            else
                            {
                                <i class="bi bi-credit-card me-2"></i>
                            }
                            Start &amp; pay my share
                        </button>
                    </div>
                }
            </div>
        }
    </aside>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    private bool _placing;
    private string? _error;
    private bool _splitOpen;
    private int _participantCount = RescueCircles.MinParticipants;
    private string? _logisticsNote;

    protected override void OnInitialized()
    {
        CartService.OnChange += HandleCartChanged;
    }

    private void HandleCartChanged() => InvokeAsync(StateHasChanged);

    private async Task Close()
    {
        await IsOpenChanged.InvokeAsync(false);
    }

    // Sends the browser off to Stripe's hosted Checkout page — the cart itself is only cleared
    // once payment is confirmed on the /checkout/return page (see PaymentReturn.razor), since the
    // Order (and this basket) shouldn't be considered placed until then.
    private async Task StartCheckoutAsync()
    {
        if (CartService.BusinessId is null || _placing)
            return;

        _placing = true;
        _error = null;

        var businessId = CartService.BusinessId.Value;
        var lines = CartService.Items.Select(i => new OrderLineRequest(i.Package.Id, i.Quantity)).ToList();
        var result = await PaymentController.CreateCheckoutSessionAsync(businessId, lines, _logisticsNote);

        // PaymentController returns Conflict() for auth/stock/unconfigured-Stripe failures instead of throwing.
        if (result.Result is ConflictObjectResult conflict)
        {
            _placing = false;
            _error = conflict.Value?.ToString() ?? "We couldn't start checkout. Please try again.";
            return;
        }

        Navigation.NavigateTo(result.Value!, forceLoad: true);
    }

    // Unlike a solo checkout, a Rescue Circle's Order is placed immediately (see
    // RescueCircleService.StartCircleAsync) — the group hasn't finished paying yet, but the basket
    // itself has already become a real (Pending) order, so the cart is cleared right away instead
    // of waiting for the /circles/return confirmation the way PaymentReturn.razor does.
    private async Task StartCircleAsync()
    {
        if (CartService.BusinessId is null || _placing)
            return;

        _placing = true;
        _error = null;

        var businessId = CartService.BusinessId.Value;
        var lines = CartService.Items.Select(i => new OrderLineRequest(i.Package.Id, i.Quantity)).ToList();
        var result = await RescueCircleController.StartCircleAsync(businessId, lines, _participantCount, _logisticsNote);

        if (result.Result is ConflictObjectResult conflict)
        {
            _placing = false;
            _error = conflict.Value?.ToString() ?? "We couldn't start this Rescue Circle. Please try again.";
            return;
        }

        await CartService.ClearAsync();
        Navigation.NavigateTo(result.Value!, forceLoad: true);
    }

    public void Dispose()
    {
        CartService.OnChange -= HandleCartChanged;
    }
}
