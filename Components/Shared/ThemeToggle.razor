@inject IJSRuntime JS

@* Icon only flips after the first render confirms the real DOM state (JS interop needs it) — see
   EcoMeal.theme in site.js and the no-flash inline script in App.razor's <head>. *@
<button type="button" class="@TriggerClass" title="Toggle dark mode" aria-label="Toggle dark mode" @onclick="ToggleAsync">
    <i class="bi @(_isDark ? "bi-sun" : "bi-moon-stars")"></i>
</button>

@code {
    [Parameter] public string TriggerClass { get; set; } = "";

    private bool _isDark;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _isDark = await JS.InvokeAsync<string>("EcoMeal.theme.get") == "dark";
            StateHasChanged();
        }
    }

    private async Task ToggleAsync()
    {
        _isDark = await JS.InvokeAsync<string>("EcoMeal.theme.toggle") == "dark";
    }
}
