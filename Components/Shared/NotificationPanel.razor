@using Microsoft.AspNetCore.Components.Authorization
@using Netrom_Eco_Meal.Controllers
@using Netrom_Eco_Meal.Entities
@using Netrom_Eco_Meal.Services
@implements IDisposable
@inject NotificationPanelState PanelState
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject PushSubscriptionController PushSubscriptionController

@* Rendered once at the layout's top level, not inside NotificationBell — a trigger nested in
   .sidebar/.public-header traps a fixed popup under <main> (sticky ancestors always create a
   stacking context). Centered like ConfirmDialog/ReportDialog, which don't have this problem. *@
@if (PanelState.IsOpen)
{
    <div class="notif-panel-backdrop" @onclick="() => PanelState.Close()"></div>
    <div class="notif-panel" role="dialog" aria-modal="true" aria-label="Notifications">
        <div class="notif-panel-header">
            <span>Notifications</span>
            <div class="notif-panel-header-actions">
                <AuthorizeView>
                    <Authorized>
                        @if (_pushPublicKey is not null && _pushSupported)
                        {
                            <button type="button" class="notif-push-toggle @(_pushEndpoint is not null ? "notif-push-toggle-on" : "")"
                                    title="@(_pushEndpoint is not null ? "Disable browser alerts" : "Enable browser alerts")"
                                    disabled="@_pushBusy" @onclick="TogglePushAsync">
                                <i class="bi @(_pushEndpoint is not null ? "bi-bell-fill" : "bi-bell-slash")"></i>
                            </button>
                        }
                    </Authorized>
                </AuthorizeView>
                @if (PanelState.UnreadCount > 0)
                {
                    <button type="button" class="notif-mark-all" @onclick="() => PanelState.MarkAllReadAsync()">Mark all read</button>
                }
            </div>
        </div>
        @if (_pushError is not null)
        {
            <div class="notif-push-error">@_pushError</div>
        }
        <div class="notif-panel-list">
            @if (PanelState.Notifications is null)
            {
                <div class="notif-empty">Loading…</div>
            }
            else if (PanelState.Notifications.Count == 0)
            {
                <div class="notif-empty">
                    <i class="bi bi-check2-circle"></i>
                    You're all caught up.
                </div>
            }
            else
            {
                @foreach (var notification in PanelState.Notifications)
                {
                    <button type="button" class="notif-item @(notification.IsRead ? "" : "notif-item-unread")" @onclick="() => OpenAsync(notification)">
                        <span class="notif-item-message">@notification.Message</span>
                        <span class="notif-item-time">@RelativeTime(notification.CreatedAt)</span>
                    </button>
                }
            }
        </div>
    </div>
}

@code {
    private bool _pushSupported;
    private string? _pushPublicKey;
    private string? _pushEndpoint;
    private bool _pushBusy;
    private string? _pushError;

    protected override async Task OnInitializedAsync()
    {
        PanelState.OnChange += HandleChanged;
        await PanelState.InitializeAsync();
    }

    // Deferred to OnAfterRenderAsync — JS interop isn't available until the component has
    // actually rendered once, same reasoning as CartService.RestoreAsync in PublicLayout.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        // Null when WebPush isn't configured server-side — the toggle stays hidden entirely,
        // same degrade-gracefully pattern as a missing Stripe/SMTP config elsewhere in the app.
        _pushPublicKey = PushSubscriptionController.GetPublicKey().Value;
        if (_pushPublicKey is null)
            return;

        _pushSupported = await JSRuntime.InvokeAsync<bool>("EcoMeal.push.isSupported");
        if (!_pushSupported)
            return;

        _pushEndpoint = await JSRuntime.InvokeAsync<string?>("EcoMeal.push.getSubscriptionEndpoint");
        StateHasChanged();
    }

    private async Task TogglePushAsync()
    {
        _pushBusy = true;
        _pushError = null;
        StateHasChanged();

        try
        {
            if (_pushEndpoint is not null)
            {
                var unsubscribedEndpoint = await JSRuntime.InvokeAsync<string?>("EcoMeal.push.unsubscribe");
                if (unsubscribedEndpoint is not null)
                    await PushSubscriptionController.UnsubscribeAsync(unsubscribedEndpoint);
                _pushEndpoint = null;
            }
            else
            {
                var subscription = await JSRuntime.InvokeAsync<PushSubscriptionInfo?>("EcoMeal.push.subscribe", _pushPublicKey);
                if (subscription is null)
                {
                    _pushError = "Couldn't enable browser alerts — check your browser's notification permission.";
                }
                else
                {
                    await PushSubscriptionController.SubscribeAsync(subscription.Endpoint, subscription.P256Dh, subscription.Auth);
                    _pushEndpoint = subscription.Endpoint;
                }
            }
        }
        finally
        {
            _pushBusy = false;
        }
    }

    private void HandleChanged() => InvokeAsync(StateHasChanged);

    private async Task OpenAsync(Notification notification)
    {
        await PanelState.MarkAsReadAsync(notification);
        PanelState.Close();
        if (notification.Url is not null)
            NavigationManager.NavigateTo(notification.Url);
    }

    private static string RelativeTime(DateTime utc)
    {
        var span = DateTime.UtcNow - utc;
        if (span.TotalMinutes < 1) return "just now";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes}m ago";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours}h ago";
        return $"{(int)span.TotalDays}d ago";
    }

    public void Dispose()
    {
        PanelState.OnChange -= HandleChanged;
    }

    // Shape of EcoMeal.push.subscribe's resolved value (site.js) — JS interop matches property
    // names case-insensitively, same convention Home.razor's GeoPosition already relies on.
    private class PushSubscriptionInfo
    {
        public string Endpoint { get; set; } = "";
        public string P256Dh { get; set; } = "";
        public string Auth { get; set; } = "";
    }
}
