@inject IJSRuntime JS

<button type="button" @ref="_anchorRef" class="@TriggerClass" disabled="@Disabled" title="@Title" @onclick="() => OnToggle.InvokeAsync()">
    @Trigger
</button>

@if (IsOpen)
{
    <div class="role-dropdown-backdrop" @onclick="() => OnClose.InvokeAsync()"></div>
    <div class="@PanelClass" @ref="_panelRef" style="visibility:hidden;">
        @Content
    </div>
}

@code {
    [Parameter] public RenderFragment? Trigger { get; set; }
    [Parameter] public RenderFragment? Content { get; set; }
    [Parameter] public string TriggerClass { get; set; } = "role-badge";
    [Parameter] public string PanelClass { get; set; } = "role-dropdown";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnToggle { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private ElementReference _anchorRef;
    private ElementReference _panelRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Reposition on every render while open — content that loads in async (e.g. the
        // notification list) can grow the panel past its first, smaller measurement.
        if (IsOpen)
            await JS.InvokeVoidAsync("EcoMeal.positionDropdown", _anchorRef, _panelRef);
    }
}
