@using Netrom_Eco_Meal.Services
@implements IDisposable
@inject NotificationPanelState PanelState

@* Trigger only — the popup itself is NotificationPanel, rendered at the layout's top level so it
   can't get trapped in the sidebar's stacking context. See NotificationPanelState for why. *@
<button type="button" class="@TriggerClass" title="Notifications" @onclick="() => PanelState.ToggleAsync()">
    <i class="bi bi-bell"></i>
    @if (PanelState.UnreadCount > 0)
    {
        <span class="notif-badge">@(PanelState.UnreadCount > 9 ? "9+" : PanelState.UnreadCount.ToString())</span>
    }
</button>

@code {
    [Parameter] public string TriggerClass { get; set; } = "notif-bell-btn";

    protected override async Task OnInitializedAsync()
    {
        PanelState.OnChange += HandleChanged;
        await PanelState.InitializeAsync();
    }

    private void HandleChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        PanelState.OnChange -= HandleChanged;
    }
}
