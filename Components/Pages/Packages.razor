@page "/packages"
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Mvc
@using Netrom_Eco_Meal.Constants
@using Netrom_Eco_Meal.Controllers
@using Netrom_Eco_Meal.Entities
@using Netrom_Eco_Meal.Models
@using Netrom_Eco_Meal.Services
@using Netrom_Eco_Meal.Services.Interfaces
@* prerender: false — a hard navigation would otherwise paint a static copy first, and a click
   landing before the real circuit swaps in (e.g. a bulk-select checkbox) gets silently lost. *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IDisposable
@inject PackageController PackageController
@inject IBusinessService BusinessService
@inject IPackageTypeService PackageTypeService
@inject AuthenticationStateProvider AuthStateProvider
@inject ClientTimeZoneService ClientTimeZoneService
@inject ManagedBusinessContext ManagedBusinessContext
@attribute [Authorize(Roles = $"{AppRoles.Admin},{AppRoles.BusinessManager}")]

<PageTitle>Packages — Eco Meal</PageTitle>

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1">Packages</h1>
        <p class="text-muted small mb-0">Manage all available food packages</p>
    </div>
    @if (_isAdmin || _myBusinessId is not null)
    {
        <div class="d-flex gap-2">
            <a href="/packages/templates" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-repeat me-1"></i> Recurring templates
            </a>
            <a href="/packages/create" class="btn btn-primary px-4">
                <i class="bi bi-plus-lg me-1"></i> Add Package
            </a>
        </div>
    }
</div>

@if (_paged is not null)
{
    <div class="d-flex gap-3 mb-3 flex-wrap">
        <div class="input-group" style="max-width: 320px;">
            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
            <input type="text" class="form-control border-start-0 ps-0" placeholder="Search name or description…"
                   @bind="_search" @bind:event="oninput" @bind:after="OnSearchInputAsync" />
        </div>
        @if (_isAdmin)
        {
            <select class="form-select" style="max-width: 200px;" @bind="_businessFilter" @bind:after="FilterChangedAsync">
                <option value="">All businesses</option>
                @foreach (var b in _allBusinesses)
                {
                    <option value="@b.Id">@b.Name</option>
                }
            </select>
        }
        <select class="form-select" style="max-width: 180px;" @bind="_typeFilter" @bind:after="FilterChangedAsync">
            <option value="">All types</option>
            @foreach (var t in _packageTypes)
            {
                <option value="@t.Id">@t.Name</option>
            }
        </select>
        @if (!string.IsNullOrEmpty(_search) || _businessFilter != "" || _typeFilter != "")
        {
            <button class="btn btn-outline-secondary" @onclick="ClearFiltersAsync">
                <i class="bi bi-x-lg me-1"></i> Clear
            </button>
        }
        <span class="align-self-center text-muted small ms-auto">@_paged.TotalCount result@(_paged.TotalCount == 1 ? "" : "s")</span>
    </div>
}

@if (_bulkError is not null && _bulkMode == BulkMode.None)
{
    <div class="alert alert-danger" role="alert">@_bulkError</div>
}

@if (_selectedIds.Count > 0)
{
    <div class="card border-0 shadow-sm bulk-toolbar mb-3">
        <div class="card-body d-flex align-items-center gap-3 flex-wrap py-2">
            <span class="fw-semibold small">@_selectedIds.Count selected</span>
            <div class="d-flex gap-2 flex-wrap ms-auto">
                <button class="btn btn-sm btn-outline-secondary" disabled="@_bulkBusy" @onclick="() => _confirmingDuplicate = true">
                    <i class="bi bi-copy me-1"></i> Duplicate
                </button>
                <button class="btn btn-sm btn-outline-secondary" disabled="@_bulkBusy" @onclick="OpenAdjustQuantity">
                    <i class="bi bi-dash-slash-lg me-1"></i> Adjust quantity
                </button>
                <button class="btn btn-sm btn-outline-secondary" disabled="@_bulkBusy" @onclick="OpenExtendPickup">
                    <i class="bi bi-clock-history me-1"></i> Extend pickup window
                </button>
                <button class="btn btn-sm btn-link text-muted" disabled="@_bulkBusy" @onclick="() => _selectedIds.Clear()">
                    Clear selection
                </button>
            </div>
        </div>
    </div>
}

<div class="card border-0 shadow-sm">
    @if (_paged is null)
    {
        <div class="d-flex justify-content-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (_paged.Items.Count == 0)
    {
        <div class="text-center py-5">
            <i class="bi bi-box-seam fs-1 text-muted d-block mb-3"></i>
            <p class="text-muted mb-3">@(_paged.TotalCount == 0 && string.IsNullOrEmpty(_search) && _businessFilter == "" && _typeFilter == "" ? "No packages available yet." : "No packages match your filters.")</p>
            @if (_paged.TotalCount == 0 && (_isAdmin || _myBusinessId is not null))
            {
                <a href="/packages/create" class="btn btn-outline-primary">Create your first package</a>
            }
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead>
                <tr class="border-bottom">
                    @if (_isAdmin || _isBusinessManager)
                    {
                        <th class="ps-4 py-3" style="width: 2.5rem;">
                            <input type="checkbox" class="form-check-input" checked="@AllSelectableOnPageSelected"
                                   disabled="@(!SelectablePackagesOnPage.Any())"
                                   @onchange="e => ToggleSelectAll((bool)e.Value!)" aria-label="Select all on this page"/>
                        </th>
                    }
                    <th class="px-4 py-3 text-uppercase text-muted small fw-semibold">Name</th>
                    <th class="py-3 text-uppercase text-muted small fw-semibold">Business</th>
                    <th class="py-3 text-uppercase text-muted small fw-semibold">Type</th>
                    <th class="py-3 text-uppercase text-muted small fw-semibold">Price</th>
                    <th class="py-3 text-uppercase text-muted small fw-semibold">Qty</th>
                    <th class="py-3 text-uppercase text-muted small fw-semibold">Pickup</th>
                    @if (_isAdmin || _isBusinessManager)
                    {
                        <th class="py-3 text-uppercase text-muted small fw-semibold">Actions</th>
                    }
                </tr>
                </thead>
                <tbody>
                @* Managers only see packages belonging to their currently selected business here. *@
                @foreach (var package in _paged.Items)
                {
                    var canManage = _isAdmin || (_isBusinessManager && package.BusinessId == _myBusinessId);
                    <tr>
                        @if (_isAdmin || _isBusinessManager)
                        {
                            <td class="ps-4">
                                @if (canManage)
                                {
                                    <input type="checkbox" class="form-check-input" checked="@_selectedIds.Contains(package.Id)"
                                           @onchange="e => ToggleSelect(package.Id, (bool)e.Value!)" aria-label="Select @package.Name"/>
                                }
                            </td>
                        }
                        <td class="px-4" style="max-width: 380px;">
                            <div class="fw-semibold text-truncate" title="@package.Name">
                                @package.Name
                                @if (package.TemplateId is not null)
                                {
                                    <span class="badge rounded-pill bg-light text-muted border ms-1" title="Auto-generated daily by a recurring template">
                                        <i class="bi bi-arrow-repeat"></i> Daily
                                    </span>
                                }
                                @if (package.IsHidden)
                                {
                                    <span class="badge rounded-pill bg-secondary-subtle text-secondary ms-1" title="@package.HiddenReason">
                                        <i class="bi bi-eye-slash"></i> Hidden
                                    </span>
                                }
                            </div>
                            <div class="text-muted small">@package.Description</div>
                        </td>
                        <td>@package.Business.Name</td>
                        <td>
                            <span class="badge rounded-pill px-3 py-2 package-type-badge">
                                @package.PackageType.Name
                            </span>
                        </td>
                        <td class="fw-semibold">
                            @package.Price.ToString("C")
                            @if (canManage && _markdownCandidateIds.Contains(package.Id))
                            {
                                <button type="button" class="btn btn-sm btn-link p-0 ms-1" title="AI price suggestion available — this package is closing soon with stock left" @onclick="() => OpenMarkdownSuggestionAsync(package)">
                                    <i class="bi bi-tag-fill text-warning"></i>
                                </button>
                            }
                        </td>
                        <td>@package.Quantity</td>
                        <td class="text-muted small">
                            @PickupLabel(package)
                        </td>
                        @if (_isAdmin || _isBusinessManager)
                        {
                            <td>
                                @if (canManage)
                                {
                                    <div class="d-flex gap-2">
                                        <a href="/packages/edit/@package.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        @if (package.IsHidden)
                                        {
                                            <button class="btn btn-sm btn-outline-secondary" title="Unhide" @onclick="() => UnhideAsync(package)">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-outline-secondary" title="Hide from storefront" @onclick="() => OpenHidePrompt(package)">
                                                <i class="bi bi-eye-slash"></i>
                                            </button>
                                        }
                                        <button class="btn btn-sm btn-outline-danger" title="Delete" @onclick="() => RequestDelete(package)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                }
                            </td>
                        }
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <Pagination CurrentPage="_paged.PageIndex" TotalPages="_paged.TotalPages" OnPageChange="PageChangedAsync" />
    }
</div>

<ConfirmDialog IsOpen="@(_pendingDelete is not null)"
               Title="Delete package?"
               Message="@(_pendingDelete is null ? "" : $"\"{_pendingDelete.Name}\" will be permanently removed and can no longer be ordered. This can't be undone.")"
               ConfirmLabel="Delete package"
               Busy="@_deleting"
               OnConfirm="ConfirmDeleteAsync"
               OnCancel="() => _pendingDelete = null"/>

<ReportDialog IsOpen="@(_hidePromptPackage is not null)"
              TargetLabel="@(_hidePromptPackage is null ? "" : _hidePromptPackage.Name)"
              Title="@(_hidePromptPackage is null ? "" : $"Hide \"{_hidePromptPackage.Name}\"?")"
              Message="It'll disappear from the customer-facing storefront immediately, but stays intact for you to edit or unhide later."
              Placeholder="Reason (shown if someone hovers the Hidden badge)"
              ConfirmLabel="Hide package"
              Busy="@_hidePromptBusy"
              Error="@_hidePromptError"
              OnSubmit="SubmitHidePromptAsync"
              OnCancel="() => { _hidePromptPackage = null; _hidePromptError = null; }"/>

<ConfirmDialog IsOpen="_confirmingDuplicate"
               Title="Duplicate packages?"
               Message="@($"{_selectedIds.Count} package{(_selectedIds.Count == 1 ? "" : "s")} will be copied with the same name, price, and pickup window. Adjust the copies afterward as needed.")"
               ConfirmLabel="Duplicate"
               ConfirmClass="btn-primary"
               Busy="@_bulkBusy"
               OnConfirm="DuplicateSelectedAsync"
               OnCancel="() => _confirmingDuplicate = false"/>

@if (_bulkMode != BulkMode.None)
{
    <div class="confirm-backdrop" @onclick="CloseBulkModal"></div>
    <div class="confirm-dialog" role="dialog" aria-modal="true" aria-labelledby="bulk-modal-title">
        @if (_bulkMode == BulkMode.AdjustQuantity)
        {
            <h2 class="confirm-dialog-title" id="bulk-modal-title">Adjust quantity</h2>
            <p class="confirm-dialog-message">
                Applied to @_selectedIds.Count selected package@(_selectedIds.Count == 1 ? "" : "s"). Use a negative
                number to reduce stock — it won't go below 0.
            </p>
            <div class="mb-3">
                <label for="bulkQtyDelta" class="form-label fw-semibold small">Change quantity by</label>
                <input id="bulkQtyDelta" type="number" class="form-control" @bind="_bulkQuantityDelta"/>
            </div>
        }
        else
        {
            <h2 class="confirm-dialog-title" id="bulk-modal-title">Extend pickup window</h2>
            <p class="confirm-dialog-message">
                Pushes the pickup end time later for @_selectedIds.Count selected package@(_selectedIds.Count == 1 ? "" : "s"). The start time is unchanged.
            </p>
            <div class="mb-3">
                <label for="bulkExtendHours" class="form-label fw-semibold small">Extend by (hours)</label>
                <input id="bulkExtendHours" type="number" min="0.5" step="0.5" class="form-control" @bind="_bulkExtendHours"/>
            </div>
        }
        @if (_bulkError is not null)
        {
            <p class="text-danger small">@_bulkError</p>
        }
        <div class="confirm-dialog-actions">
            <button type="button" class="btn btn-outline-secondary" disabled="@_bulkBusy" @onclick="CloseBulkModal">Cancel</button>
            <button type="button" class="btn btn-primary" disabled="@_bulkBusy" @onclick="ApplyBulkModalAsync">
                @if (_bulkBusy)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                }
                Apply
            </button>
        </div>
    </div>
}

@if (_markdownSuggestionPackage is not null)
{
    <div class="confirm-backdrop" @onclick="CloseMarkdownSuggestion"></div>
    <div class="confirm-dialog" role="dialog" aria-modal="true" aria-labelledby="markdown-modal-title">
        <h2 class="confirm-dialog-title" id="markdown-modal-title">
            <i class="bi bi-tag-fill text-warning me-1"></i> AI price suggestion — @_markdownSuggestionPackage.Name
        </h2>
        @if (_markdownSuggestionLoading)
        {
            <div class="d-flex justify-content-center py-4">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        }
        else if (_markdownSuggestionError is not null)
        {
            <p class="text-danger small mb-0">@_markdownSuggestionError</p>
        }
        else if (_markdownSuggestion is null)
        {
            <p class="confirm-dialog-message mb-0">No markdown suggested right now — the real sell-through history didn't give the AI a good reason to cut this package's price.</p>
        }
        else
        {
            <div class="d-flex align-items-baseline gap-2 mb-2">
                <span class="text-muted text-decoration-line-through">@_markdownSuggestion.CurrentPrice.ToString("C")</span>
                <span class="fw-bold fs-4 text-success">@_markdownSuggestion.SuggestedPrice.ToString("C")</span>
            </div>
            <p class="confirm-dialog-message">@_markdownSuggestion.Explanation</p>
            <p class="text-muted small mb-0">Just a suggestion — nothing changes until you edit the package yourself.</p>
        }
        <div class="confirm-dialog-actions">
            <button type="button" class="btn btn-outline-secondary" disabled="@_markdownDismissBusy" @onclick="CloseMarkdownSuggestion">Close</button>
            @if (_markdownSuggestion is not null)
            {
                <a href="/packages/edit/@_markdownSuggestionPackage.Id" class="btn btn-outline-primary">Edit package</a>
            }
            <button type="button" class="btn btn-primary" disabled="@(_markdownDismissBusy || _markdownSuggestionLoading)" @onclick="DismissMarkdownSuggestionAsync">
                @if (_markdownDismissBusy)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                }
                Dismiss
            </button>
        </div>
    </div>
}

@code {
    private enum BulkMode { None, AdjustQuantity, ExtendPickup }
    private PaginatedList<Package>? _paged;
    private List<Business> _allBusinesses = [];
    private List<PackageType> _packageTypes = [];
    private string _search = "";
    private string _businessFilter = "";
    private string _typeFilter = "";
    private bool _isAdmin;
    private bool _isBusinessManager;
    private Guid? _myBusinessId;
    private Package? _pendingDelete;
    private bool _deleting;
    private Package? _hidePromptPackage;
    private bool _hidePromptBusy;
    private string? _hidePromptError;
    private int _pageIndex = 1;
    private const int PageSize = 10;
    // Guards every reload trigger (search, filters, paging, post-mutation refresh) so
    // overlapping ones cancel each other instead of using the shared DbContext concurrently.
    private readonly Debouncer _reloadGate = new();

    // Selection persists across pages/filters so a manager can build it up while paging, then act on all of it at once.
    private readonly HashSet<Guid> _selectedIds = [];
    private bool _confirmingDuplicate;
    private BulkMode _bulkMode = BulkMode.None;
    private int _bulkQuantityDelta;
    private double _bulkExtendHours = 1;
    private bool _bulkBusy;
    private string? _bulkError;

    // Candidate ids are fetched business-wide (not paginated) so the 🏷️ badge shows regardless of
    // which page a candidate lands on; the actual AI call only happens once a manager clicks it.
    private HashSet<Guid> _markdownCandidateIds = [];
    private Package? _markdownSuggestionPackage;
    private bool _markdownSuggestionLoading;
    private MarkdownSuggestion? _markdownSuggestion;
    private string? _markdownSuggestionError;
    private bool _markdownDismissBusy;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _isAdmin = authState.User.IsInRole(AppRoles.Admin);
        _isBusinessManager = authState.User.IsInRole(AppRoles.BusinessManager);

        if (_isBusinessManager)
        {
            await ManagedBusinessContext.EnsureLoadedAsync();
            _myBusinessId = ManagedBusinessContext.SelectedBusinessId;
        }

        _allBusinesses = (await BusinessService.GetAllAsync())?.OrderBy(b => b.Name).ToList() ?? [];
        _packageTypes = (await PackageTypeService.GetAllAsync()).OrderBy(t => t.Name).ToList();

        await LoadPageAsync();
        await LoadMarkdownCandidatesAsync();

        ClientTimeZoneService.OnChange += HandleTimeZoneChanged;
        ManagedBusinessContext.OnChange += HandleManagedBusinessChanged;
    }

    private async void HandleManagedBusinessChanged()
    {
        _myBusinessId = ManagedBusinessContext.SelectedBusinessId;
        _pageIndex = 1;
        // A selection built up under the previous business no longer applies once it changes.
        _selectedIds.Clear();
        await InvokeAsync(async () =>
        {
            await LoadPageAsync();
            await LoadMarkdownCandidatesAsync();
            StateHasChanged();
        });
    }

    // Admin sees candidates across every business (mirrors GetForAnalyticsAsync's null-businessId
    // convention); an unassigned manager gets the same Guid.Empty-never-matches sentinel LoadPageAsync uses.
    private async Task LoadMarkdownCandidatesAsync()
    {
        if (!_isAdmin && !_isBusinessManager)
            return;

        Guid? businessId = _isBusinessManager ? _myBusinessId ?? Guid.Empty : null;
        var result = await PackageController.GetMarkdownCandidatesAsync(businessId);
        _markdownCandidateIds = result.Result is UnauthorizedResult ? [] : (result.Value ?? []).Select(p => p.Id).ToHashSet();
    }

    private async Task OpenMarkdownSuggestionAsync(Package package)
    {
        _markdownSuggestionPackage = package;
        _markdownSuggestion = null;
        _markdownSuggestionError = null;
        _markdownSuggestionLoading = true;

        var result = await PackageController.GetMarkdownSuggestionAsync(package.Id);
        if (result.Result is UnauthorizedResult)
        {
            _markdownSuggestionError = "You don't have access to a price suggestion for this package.";
        }
        else if (result.Result is ConflictObjectResult conflict)
        {
            _markdownSuggestionError = conflict.Value as string ?? "AI features aren't available right now.";
        }
        else
        {
            _markdownSuggestion = result.Value;
        }

        _markdownSuggestionLoading = false;
    }

    private void CloseMarkdownSuggestion()
    {
        _markdownSuggestionPackage = null;
        _markdownSuggestion = null;
        _markdownSuggestionError = null;
    }

    private async Task DismissMarkdownSuggestionAsync()
    {
        if (_markdownSuggestionPackage is null)
            return;

        _markdownDismissBusy = true;
        try
        {
            await PackageController.DismissMarkdownSuggestionAsync(_markdownSuggestionPackage.Id);
            _markdownCandidateIds.Remove(_markdownSuggestionPackage.Id);
            CloseMarkdownSuggestion();
        }
        catch (Exception)
        {
            _markdownSuggestionError = "Couldn't dismiss this suggestion. Please refresh and try again.";
        }
        finally
        {
            _markdownDismissBusy = false;
        }
    }

    private IEnumerable<Package> SelectablePackagesOnPage =>
        _paged?.Items.Where(p => _isAdmin || (_isBusinessManager && p.BusinessId == _myBusinessId)) ?? [];

    private bool AllSelectableOnPageSelected =>
        SelectablePackagesOnPage.Any() && SelectablePackagesOnPage.All(p => _selectedIds.Contains(p.Id));

    private void ToggleSelectAll(bool select)
    {
        foreach (var package in SelectablePackagesOnPage)
        {
            if (select) _selectedIds.Add(package.Id);
            else _selectedIds.Remove(package.Id);
        }
    }

    private void ToggleSelect(Guid id, bool select)
    {
        if (select) _selectedIds.Add(id);
        else _selectedIds.Remove(id);
    }

    private void OpenAdjustQuantity()
    {
        _bulkMode = BulkMode.AdjustQuantity;
        _bulkQuantityDelta = 0;
        _bulkError = null;
    }

    private void OpenExtendPickup()
    {
        _bulkMode = BulkMode.ExtendPickup;
        _bulkExtendHours = 1;
        _bulkError = null;
    }

    private void CloseBulkModal()
    {
        _bulkMode = BulkMode.None;
        _bulkError = null;
    }

    private async Task DuplicateSelectedAsync()
    {
        _bulkBusy = true;
        _bulkError = null;
        try
        {
            await PackageController.DuplicateManyAsync(_selectedIds.ToList());
            _selectedIds.Clear();
            await ReloadAsync();
        }
        catch (Exception)
        {
            // e.g. a selected package's business no longer matches the caller's access — close the
            // dialog so the page-level alert (ConfirmDialog has no error slot of its own) is visible,
            // instead of leaving the spinner stuck forever with no feedback.
            _bulkError = "Couldn't duplicate the selected packages. Please refresh and try again.";
        }
        finally
        {
            _bulkBusy = false;
            _confirmingDuplicate = false;
        }
    }

    private async Task ApplyBulkModalAsync()
    {
        if (_bulkMode == BulkMode.AdjustQuantity && _bulkQuantityDelta == 0)
        {
            _bulkError = "Enter a non-zero amount.";
            return;
        }
        if (_bulkMode == BulkMode.ExtendPickup && _bulkExtendHours <= 0)
        {
            _bulkError = "Enter a positive number of hours.";
            return;
        }

        _bulkBusy = true;
        _bulkError = null;

        try
        {
            if (_bulkMode == BulkMode.AdjustQuantity)
                await PackageController.AdjustQuantityManyAsync(_selectedIds.ToList(), _bulkQuantityDelta);
            else
                await PackageController.ExtendPickupWindowManyAsync(_selectedIds.ToList(), _bulkExtendHours);

            _bulkMode = BulkMode.None;
            _selectedIds.Clear();
            await ReloadAsync();
        }
        catch (Exception)
        {
            // Same reasoning as DuplicateSelectedAsync — don't leave the modal stuck busy with no feedback.
            _bulkError = "Couldn't apply this to the selected packages. Please refresh and try again.";
        }
        finally
        {
            _bulkBusy = false;
        }
    }

    private async Task LoadPageAsync()
    {
        // An unassigned manager has no business — fall back to a Guid that can never match
        // rather than leaving the filter null, which would otherwise show every business's packages.
        Guid? businessId = _isBusinessManager ? _myBusinessId ?? Guid.Empty : (Guid.TryParse(_businessFilter, out var bId) ? bId : null);
        Guid? packageTypeId = Guid.TryParse(_typeFilter, out var tId) ? tId : null;
        _paged = (await PackageController.GetPagedAsync(_pageIndex, PageSize, _search, businessId, packageTypeId)).Value;

        // A mutation (e.g. deleting the last item on the last page) can shrink TotalPages below
        // the page we're currently viewing — re-fetch the now-last valid page instead of showing empty.
        if (_paged is not null && _paged.Items.Count == 0 && _pageIndex > _paged.TotalPages)
        {
            _pageIndex = _paged.TotalPages;
            _paged = (await PackageController.GetPagedAsync(_pageIndex, PageSize, _search, businessId, packageTypeId)).Value;
        }
    }

    private Task ReloadAsync(int delayMs = 0) => _reloadGate.DebounceAsync(LoadPageAsync, delayMs);

    private Task OnSearchInputAsync()
    {
        _pageIndex = 1;
        return ReloadAsync(300);
    }

    private Task FilterChangedAsync()
    {
        _pageIndex = 1;
        return ReloadAsync();
    }

    private Task PageChangedAsync(int page)
    {
        _pageIndex = page;
        return ReloadAsync();
    }

    private string PickupLabel(Package package)
    {
        var start = ClientTimeZoneService.ToLocal(package.PickupStart);
        var end = ClientTimeZoneService.ToLocal(package.PickupEnd);
        return start.Date == end.Date
            ? FormattableString.Invariant($"{start:MMM d} · {start:HH:mm}–{end:HH:mm}")
            : FormattableString.Invariant($"{start:MMM d, HH:mm} – {end:MMM d, HH:mm}");
    }

    private void HandleTimeZoneChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        ClientTimeZoneService.OnChange -= HandleTimeZoneChanged;
        ManagedBusinessContext.OnChange -= HandleManagedBusinessChanged;
    }

    private Task ClearFiltersAsync()
    {
        _search         = "";
        _businessFilter = "";
        _typeFilter     = "";
        return FilterChangedAsync();
    }

    private void RequestDelete(Package package)
    {
        if (!_isAdmin && package.BusinessId != _myBusinessId)
            return;

        _pendingDelete = package;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_pendingDelete is null)
            return;

        _deleting = true;
        await PackageController.DeleteAsync(_pendingDelete);
        await ReloadAsync();
        _deleting = false;
        _pendingDelete = null;
    }

    private void OpenHidePrompt(Package package)
    {
        if (!_isAdmin && package.BusinessId != _myBusinessId)
            return;

        _hidePromptPackage = package;
    }

    private async Task SubmitHidePromptAsync(string reason)
    {
        if (_hidePromptPackage is null || string.IsNullOrWhiteSpace(reason))
            return;

        _hidePromptBusy = true;
        _hidePromptError = null;
        try
        {
            await PackageController.HideAsync(_hidePromptPackage.Id, reason);
            await ReloadAsync();
            _hidePromptPackage = null;
        }
        catch (Exception)
        {
            // e.g. the caller's business access changed mid-session — same reasoning as
            // DuplicateSelectedAsync/ApplyBulkModalAsync, surface it instead of an unhandled
            // exception tearing down the Blazor circuit.
            _hidePromptError = "Couldn't hide this package. Please refresh and try again.";
        }
        finally
        {
            _hidePromptBusy = false;
        }
    }

    private async Task UnhideAsync(Package package)
    {
        if (!_isAdmin && package.BusinessId != _myBusinessId)
            return;

        try
        {
            await PackageController.UnhideAsync(package.Id);
            await ReloadAsync();
        }
        catch (Exception)
        {
            _bulkError = "Couldn't unhide this package. Please refresh and try again.";
        }
    }
}