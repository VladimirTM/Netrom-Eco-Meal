@page "/standing-orders"
@layout PublicLayout
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Mvc
@using Netrom_Eco_Meal.Constants
@using Netrom_Eco_Meal.Controllers
@using Netrom_Eco_Meal.Entities
@rendermode InteractiveServer
@inject StandingOrderController StandingOrderController
@attribute [Authorize(Roles = AppRoles.Customer)]

<PageTitle>Standing Orders — Eco Meal</PageTitle>

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1">Standing Orders</h1>
        <p class="text-muted small mb-0">Your saved "usuals" — set one up from a kitchen's page, and we'll reserve it in your basket the moment it goes live.</p>
    </div>
    <a href="/" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Back
    </a>
</div>

<div class="card border-0 shadow-sm">
    @if (_standingOrders is null)
    {
        <div class="d-flex justify-content-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (_standingOrders.Count == 0)
    {
        <div class="text-center py-5">
            <div class="em-empty-icon"><i class="bi bi-arrow-repeat"></i></div>
            <p class="text-muted mb-3">No standing orders yet.</p>
            <p class="text-muted small mb-0">Open a kitchen you rescue from often and look for the "Standing order" section on its page.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead>
                <tr class="border-bottom">
                    <th class="px-4 py-3 text-uppercase text-muted small fw-semibold">Kitchen</th>
                    <th class="py-3 text-uppercase text-muted small fw-semibold">Matches</th>
                    <th class="py-3 text-uppercase text-muted small fw-semibold">Weekly budget</th>
                    <th class="py-3 text-uppercase text-muted small fw-semibold">Status</th>
                    <th class="py-3 text-uppercase text-muted small fw-semibold">Actions</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var standing in _standingOrders)
                {
                    <tr @key="standing.Id">
                        <td class="px-4">
                            <a href="/businesses/@standing.BusinessId" class="fw-semibold text-decoration-none">@standing.Business.Name</a>
                        </td>
                        <td class="text-muted small">
                            @(standing.PackageType?.Name ?? "Any package")@(standing.DietaryTag is null ? "" : $" · {standing.DietaryTag}")
                        </td>
                        <td>@standing.MaxWeeklySpend.ToString("C")/week</td>
                        <td>
                            @if (standing.IsActive)
                            {
                                <span class="badge rounded-pill text-bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge rounded-pill text-bg-secondary">Paused</span>
                            }
                        </td>
                        <td>
                            <div class="d-flex gap-2">
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => ToggleActiveAsync(standing)">
                                    @(standing.IsActive ? "Pause" : "Resume")
                                </button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => RequestDelete(standing)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

<ConfirmDialog IsOpen="@(_pendingDelete is not null)"
               Title="Remove this standing order?"
               Message="@(_pendingDelete is null ? "" : $"You'll stop being notified when \"{(_pendingDelete.PackageType?.Name ?? "your usual")}\" from {_pendingDelete.Business.Name} goes live.")"
               ConfirmLabel="Remove"
               Busy="@_deleting"
               OnConfirm="ConfirmDeleteAsync"
               OnCancel="() => _pendingDelete = null"/>

@code {
    private List<StandingOrder>? _standingOrders;
    private StandingOrder? _pendingDelete;
    private bool _deleting;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _standingOrders = (await StandingOrderController.GetMyStandingOrdersAsync()).Value ?? [];
    }

    private async Task ToggleActiveAsync(StandingOrder standing)
    {
        await StandingOrderController.UpdateAsync(standing.Id, standing.MaxWeeklySpend, !standing.IsActive);
        await LoadAsync();
    }

    private void RequestDelete(StandingOrder standing) => _pendingDelete = standing;

    private async Task ConfirmDeleteAsync()
    {
        if (_pendingDelete is null)
            return;

        _deleting = true;
        await StandingOrderController.DeleteAsync(_pendingDelete.Id);
        _standingOrders?.RemoveAll(s => s.Id == _pendingDelete.Id);
        _deleting = false;
        _pendingDelete = null;
    }
}
