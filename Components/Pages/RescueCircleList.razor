@page "/circles"
@layout PublicLayout
@using Microsoft.AspNetCore.Authorization
@using Netrom_Eco_Meal.Constants
@using Netrom_Eco_Meal.Controllers
@using Netrom_Eco_Meal.Services.Interfaces
@rendermode InteractiveServer
@inject RescueCircleController RescueCircleController
@attribute [Authorize(Roles = AppRoles.Customer)]

<PageTitle>Your Rescue Circles — Eco Meal</PageTitle>

<section class="orders-hero">
    <div class="orders-hero-inner">
        <span class="orders-hero-eyebrow"><i class="bi bi-people"></i> Group orders</span>
        <h1 class="orders-hero-title">Your Rescue Circles</h1>
        <p class="orders-hero-sub">Baskets you're splitting with friends — as organizer or as a joiner.</p>
    </div>
</section>

<section class="orders-list-section">
    @if (_circles is null)
    {
        <div class="d-flex justify-content-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (_circles.Count == 0)
    {
        <div class="orders-empty">
            <i class="bi bi-people"></i>
            <p class="mb-1">No Rescue Circles yet.</p>
            <span class="text-muted small d-block mb-3">Start one from your basket to split an order with friends.</span>
            <a href="/" class="btn btn-primary px-4">Browse packages</a>
        </div>
    }
    else
    {
        <div class="orders-stack">
            @foreach (var circle in _circles)
            {
                <a href="/circles/@circle.Id" class="order-ticket order-ticket-clickable text-decoration-none text-reset d-block">
                    <div class="order-ticket-main">
                        <div class="order-ticket-top">
                            <div class="order-ticket-kitchen">
                                <div class="order-ticket-business"><i class="bi bi-shop"></i>@circle.BusinessName</div>
                            </div>
                            <span class="badge @StatusBadgeClass(circle)">@StatusLabel(circle)</span>
                        </div>
                        <div class="order-ticket-footer">
                            <div class="order-ticket-pickup">
                                <i class="bi bi-people"></i>@circle.JoinedCount of @circle.ParticipantCount joined · @circle.PaidCount paid
                            </div>
                            <div class="order-ticket-total">
                                <span>Total</span>
                                <span class="order-ticket-total-value">@circle.TotalAmount.ToString("C")</span>
                            </div>
                        </div>
                    </div>
                </a>
            }
        </div>
    }
</section>

@code {
    private List<RescueCircleSummary>? _circles;

    protected override async Task OnInitializedAsync()
    {
        _circles = (await RescueCircleController.GetMyCirclesAsync()).Value ?? [];
    }

    private static string StatusLabel(RescueCircleSummary c) => c.Status == RescueCircleStatuses.Cancelled ? "Cancelled"
        : c.PaidCount == c.ParticipantCount ? "Fully paid" : "Collecting payments";

    private static string StatusBadgeClass(RescueCircleSummary c) => c.Status == RescueCircleStatuses.Cancelled ? "bg-secondary-subtle text-secondary"
        : c.PaidCount == c.ParticipantCount ? "bg-success-subtle text-success" : "bg-warning-subtle text-warning";
}
