@page "/reports"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Mvc
@using Netrom_Eco_Meal.Constants
@using Netrom_Eco_Meal.Controllers
@using Netrom_Eco_Meal.Services.Interfaces
@rendermode InteractiveServer
@inject ReportController ReportController
@attribute [Authorize(Roles = AppRoles.Admin)]

<PageTitle>Reports — Eco Meal</PageTitle>

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1">Reports</h1>
        <p class="text-muted small mb-0">Open reports from customers about businesses and packages</p>
    </div>
</div>

@if (_error is not null)
{
    <div class="alert alert-danger" role="alert">@_error</div>
}

<div class="card border-0 shadow-sm">
    @if (_reports is null)
    {
        <div class="d-flex justify-content-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (_reports.Count == 0)
    {
        <div class="text-center py-5">
            <i class="bi bi-flag fs-1 text-muted d-block mb-3"></i>
            <p class="text-muted mb-0">No open reports — nothing needs review right now.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead>
                <tr class="border-bottom">
                    <th class="px-4 py-3 text-uppercase text-muted small fw-semibold">Target</th>
                    <th class="py-3 text-uppercase text-muted small fw-semibold">Reason</th>
                    <th class="py-3 text-uppercase text-muted small fw-semibold">Reported by</th>
                    <th class="py-3 text-uppercase text-muted small fw-semibold">Date</th>
                    <th class="py-3 text-uppercase text-muted small fw-semibold">Actions</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var view in _reports)
                {
                    <tr>
                        <td class="px-4">
                            <div class="fw-semibold">@view.TargetName</div>
                            <span class="badge rounded-pill px-2 py-1 bg-light text-muted border">
                                @(view.Report.TargetType == AuditTargetTypes.Business ? "Business" : "Package")
                            </span>
                        </td>
                        <td class="text-muted">@view.Report.Reason</td>
                        <td>@view.ReporterName</td>
                        <td class="text-muted small">@view.Report.CreatedAt.ToString("MMM d, yyyy")</td>
                        <td>
                            <div class="d-flex gap-2">
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => _pendingDismiss = view">
                                    Dismiss
                                </button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => _pendingAction = view">
                                    <i class="bi bi-eye-slash me-1"></i> Hide target
                                </button>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

<ConfirmDialog IsOpen="@(_pendingDismiss is not null)"
               Title="Dismiss this report?"
               Message="@(_pendingDismiss is null ? "" : $"No action will be taken on \"{_pendingDismiss.TargetName}\". The report is closed.")"
               ConfirmLabel="Dismiss"
               ConfirmClass="btn-secondary"
               Busy="@_busy"
               OnConfirm="ConfirmDismissAsync"
               OnCancel="() => _pendingDismiss = null"/>

<ConfirmDialog IsOpen="@(_pendingAction is not null)"
               Title="Hide this target?"
               Message="@(_pendingAction is null ? "" : $"\"{_pendingAction.TargetName}\" will be hidden from the storefront for: {_pendingAction.Report.Reason}")"
               ConfirmLabel="Hide"
               Busy="@_busy"
               OnConfirm="ConfirmTakeActionAsync"
               OnCancel="() => _pendingAction = null"/>

@code {
    private List<ReportView>? _reports;
    private ReportView? _pendingDismiss;
    private ReportView? _pendingAction;
    private bool _busy;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _reports = (await ReportController.GetOpenAsync()).Value;
    }

    private async Task ConfirmDismissAsync()
    {
        if (_pendingDismiss is null)
            return;

        _busy = true;
        _error = null;
        var result = await ReportController.DismissAsync(_pendingDismiss.Report.Id);
        if (result is UnauthorizedResult)
            _error = "You're no longer allowed to manage reports.";

        await LoadAsync();
        _busy = false;
        _pendingDismiss = null;
    }

    private async Task ConfirmTakeActionAsync()
    {
        if (_pendingAction is null)
            return;

        _busy = true;
        _error = null;
        var result = await ReportController.TakeActionAsync(_pendingAction.Report.Id, _pendingAction.Report.Reason);
        if (result is UnauthorizedResult)
            _error = "You're no longer allowed to manage reports.";

        await LoadAsync();
        _busy = false;
        _pendingAction = null;
    }
}
