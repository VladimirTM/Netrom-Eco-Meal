@page "/users"
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Mvc
@using Netrom_Eco_Meal.Constants
@using Netrom_Eco_Meal.Controllers
@using Netrom_Eco_Meal.Entities
@using Netrom_Eco_Meal.Services.Interfaces
@rendermode InteractiveServer
@inject UserController UserController
@inject BusinessController BusinessController
@inject AuthenticationStateProvider AuthStateProvider
@attribute [Authorize(Roles = AppRoles.Admin)]

<PageTitle>User Roles — Eco Meal</PageTitle>

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1">User Roles</h1>
        <p class="text-muted small mb-0">Control what each person can do across Eco Meal</p>
    </div>
</div>

@if (_roleError is not null)
{
    <div class="alert alert-danger" role="alert">@_roleError</div>
}

@if (_paged is not null)
{
    <div class="d-flex gap-3 mb-3 flex-wrap">
        <div class="input-group" style="max-width: 320px;">
            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
            <input type="text" class="form-control border-start-0 ps-0" placeholder="Search name, email…"
                   @bind="_search" @bind:event="oninput" @bind:after="OnSearchInputAsync"/>
        </div>
        <select class="form-select" style="max-width: 200px;" @bind="_roleFilter" @bind:after="FilterChangedAsync">
            <option value="">All roles</option>
            @foreach (var role in AppRoles.AllRoles)
            {
                <option value="@role">@DisplayRole(role)</option>
            }
        </select>
        @if (!string.IsNullOrEmpty(_search) || _roleFilter != "")
        {
            <button class="btn btn-outline-secondary" @onclick="ClearFiltersAsync">
                <i class="bi bi-x-lg me-1"></i> Clear
            </button>
        }
        <span class="align-self-center text-muted small ms-auto">@_paged.TotalCount result@(_paged.TotalCount == 1 ? "" : "s")</span>
    </div>
}

<div class="card border-0 shadow-sm">
    @if (_paged is null)
    {
        <div class="d-flex justify-content-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (_paged.Items.Count == 0)
    {
        <div class="text-center py-5">
            <i class="bi bi-people fs-1 text-muted d-block mb-3"></i>
            <p class="text-muted mb-0">@(_paged.TotalCount == 0 && string.IsNullOrEmpty(_search) && _roleFilter == "" ? "No users registered yet." : "No users match your filters.")</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead>
            <tr class="border-bottom">
                <th class="px-4 py-3 text-uppercase text-muted small fw-semibold">User</th>
                <th class="py-3 text-uppercase text-muted small fw-semibold">Role</th>
                <th class="py-3 text-uppercase text-muted small fw-semibold">Businesses</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var user in _paged.Items)
            {
                var isSelf = user.Id == _currentUserId;
                <tr>
                    <td class="px-4">
                        <div class="d-flex align-items-center gap-3">
                            <div class="sidebar-user-avatar" style="color:#16a34a; background:rgba(22,163,74,0.12);">@TextHelpers.GetInitial(user.Name)</div>
                            <div>
                                <div class="fw-semibold d-flex align-items-center gap-2">
                                    @user.Name
                                    @if (isSelf)
                                    {
                                        <span class="badge rounded-pill bg-light text-muted border small fw-normal">You</span>
                                    }
                                </div>
                                <div class="text-muted small">@user.Email</div>
                            </div>
                        </div>
                    </td>
                    <td class="position-relative">
                        <AnchoredDropdown TriggerClass="@($"role-badge {RoleBadgeClass(user.Role)}")"
                                          Disabled="@isSelf"
                                          Title="@(isSelf ? "You can't change your own role" : "Change role")"
                                          IsOpen="@(_openDropdownUserId == user.Id)"
                                          OnToggle="@(() => ToggleDropdown(user.Id))"
                                          OnClose="CloseDropdown">
                            <Trigger>
                                <span class="role-option-dot" style="background-color:@RoleDotColor(user.Role)"></span>
                                @DisplayRole(user.Role)
                                @if (!isSelf)
                                {
                                    <i class="bi bi-chevron-down" style="font-size:0.65rem;"></i>
                                }
                            </Trigger>
                            <Content>
                                @foreach (var role in AppRoles.AllRoles)
                                {
                                    <button type="button" class="role-option" @onclick="() => SetRoleAsync(user, role)">
                                        <span class="role-option-dot" style="background-color:@RoleDotColor(role)"></span>
                                        @DisplayRole(role)
                                        @if (role == user.Role)
                                        {
                                            <i class="bi bi-check-lg ms-auto text-muted"></i>
                                        }
                                    </button>
                                }
                            </Content>
                        </AnchoredDropdown>
                    </td>
                    <td class="position-relative">
                        @if (user.Role != AppRoles.BusinessManager)
                        {
                            <span class="text-muted small">—</span>
                        }
                        else
                        {
                            var assigned = AssignedBusinesses(user.Id);
                            <div class="d-flex flex-wrap align-items-center gap-1">
                                @foreach (var business in assigned)
                                {
                                    <span class="badge rounded-pill px-2 py-1 role-badge role-badge-businessmanager d-inline-flex align-items-center gap-1">
                                        @business.Name
                                        <button type="button" class="btn-close" style="font-size:0.55rem;" title="Remove"
                                                @onclick="() => RemoveBusinessAsync(user, business.Id)"></button>
                                    </span>
                                }
                                <AnchoredDropdown TriggerClass="role-badge role-badge-unassigned"
                                                  Title="Add business"
                                                  IsOpen="@(_openBusinessDropdownUserId == user.Id)"
                                                  OnToggle="@(() => ToggleBusinessDropdown(user.Id))"
                                                  OnClose="CloseBusinessDropdown">
                                    <Trigger>
                                        <i class="bi bi-plus-lg"></i>
                                    </Trigger>
                                    <Content>
                                        @{
                                            var assignedIds = assigned.Select(b => b.Id).ToHashSet();
                                            var available = _businesses.Where(b => !assignedIds.Contains(b.Id)).ToList();
                                        }
                                        @if (available.Count == 0)
                                        {
                                            <div class="role-option text-muted">No more businesses to add</div>
                                        }
                                        @foreach (var business in available)
                                        {
                                            <button type="button" class="role-option" @onclick="() => AddBusinessAsync(user, business.Id)">
                                                <span class="role-option-dot" style="background-color:#2563eb"></span>
                                                @business.Name
                                            </button>
                                        }
                                    </Content>
                                </AnchoredDropdown>
                            </div>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
        </div>
        <Pagination CurrentPage="_paged.PageIndex" TotalPages="_paged.TotalPages" OnPageChange="PageChangedAsync" />
    }
</div>

@code {
    private PaginatedList<UserWithRole>? _paged;
    private List<Business> _businesses = [];
    // Full list of business-manager users — needed to resolve "currently: X" in the business
    // assignment dropdown even when that manager's row isn't on the current users page.
    private List<UserWithRole> _businessManagers = [];
    private string? _currentUserId;
    private string _search = "";
    private string _roleFilter = "";
    private string? _openDropdownUserId;
    private string? _openBusinessDropdownUserId;
    private string? _roleError;
    private int _pageIndex = 1;
    private const int PageSize = 10;
    // Guards every reload trigger (search, filters, paging, post-mutation refresh) so
    // overlapping ones cancel each other instead of using the shared DbContext concurrently.
    private readonly Debouncer _reloadGate = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _currentUserId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        _businesses = (await BusinessController.GetAllAsync()).Value ?? [];
        _businessManagers = (await UserController.GetByRoleAsync(AppRoles.BusinessManager)).Value ?? [];

        await LoadPageAsync();
    }

    private async Task LoadPageAsync()
    {
        _paged = (await UserController.GetPagedAsync(_pageIndex, PageSize, _search, _roleFilter == "" ? null : _roleFilter)).Value;
    }

    private Task ReloadAsync(int delayMs = 0) => _reloadGate.DebounceAsync(LoadPageAsync, delayMs);

    private Task OnSearchInputAsync()
    {
        _pageIndex = 1;
        return ReloadAsync(300);
    }

    private Task FilterChangedAsync()
    {
        _pageIndex = 1;
        return ReloadAsync();
    }

    private Task PageChangedAsync(int page)
    {
        _pageIndex = page;
        return ReloadAsync();
    }

    private Task ClearFiltersAsync()
    {
        _search = "";
        _roleFilter = "";
        return FilterChangedAsync();
    }

    private List<Business> AssignedBusinesses(string userId) =>
        _businesses.Where(b => b.Staff.Any(s => s.UserId == userId)).ToList();

    // Role and business dropdowns are mutually exclusive — opening one closes the other.
    private void ToggleDropdown(string userId)
    {
        _openBusinessDropdownUserId = null;
        _openDropdownUserId = _openDropdownUserId == userId ? null : userId;
    }

    private void CloseDropdown()
    {
        _openDropdownUserId = null;
    }

    private void ToggleBusinessDropdown(string userId)
    {
        _openDropdownUserId = null;
        _openBusinessDropdownUserId = _openBusinessDropdownUserId == userId ? null : userId;
    }

    private void CloseBusinessDropdown()
    {
        _openBusinessDropdownUserId = null;
    }

    private async Task SetRoleAsync(UserWithRole user, string role)
    {
        _openDropdownUserId = null;
        _roleError = null;

        if (role == user.Role || _paged is null)
            return;

        var result = await UserController.UpdateRoleAsync(user.Id, role);
        if (result is ConflictObjectResult conflict)
        {
            _roleError = conflict.Value?.ToString() ?? "That role change could not be applied.";
            return;
        }

        // Reload rather than patch the row in place — the user's new role may no longer match
        // the active _roleFilter, and patching would leave it visible until the next reload.
        await ReloadAsync();

        // Moving away from BusinessManager may have auto-released a business server-side.
        _businesses = (await BusinessController.GetAllAsync()).Value ?? [];
        _businessManagers = (await UserController.GetByRoleAsync(AppRoles.BusinessManager)).Value ?? [];
    }

    // Deliberately doesn't close the dropdown — an admin can add several businesses in one open.
    private async Task AddBusinessAsync(UserWithRole user, Guid businessId)
    {
        _roleError = null;

        var result = await BusinessController.AddStaffAsync(businessId, user.Id, user.Name);
        if (result is ConflictResult)
            _roleError = "That staff assignment already exists. Please try again.";

        _businesses = (await BusinessController.GetAllAsync()).Value ?? [];
    }

    private async Task RemoveBusinessAsync(UserWithRole user, Guid businessId)
    {
        _roleError = null;

        await BusinessController.RemoveStaffAsync(businessId, user.Id);

        _businesses = (await BusinessController.GetAllAsync()).Value ?? [];
    }

    private static string DisplayRole(string role) => role switch
    {
        AppRoles.BusinessManager => "Business Manager",
        _ => role
    };

    private static string RoleBadgeClass(string role) => role switch
    {
        AppRoles.Admin => "role-badge-admin",
        AppRoles.BusinessManager => "role-badge-businessmanager",
        _ => "role-badge-customer"
    };

    private static string RoleDotColor(string role) => role switch
    {
        AppRoles.Admin => "#7c3aed",
        AppRoles.BusinessManager => "#2563eb",
        _ => "#16a34a"
    };
}