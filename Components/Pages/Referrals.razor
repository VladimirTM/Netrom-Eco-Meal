@page "/referrals"
@layout PublicLayout
@using Microsoft.AspNetCore.Authorization
@using Netrom_Eco_Meal.Constants
@using Netrom_Eco_Meal.Controllers
@using Netrom_Eco_Meal.Services.Interfaces
@rendermode InteractiveServer
@inject ReferralController ReferralController
@inject NavigationManager NavigationManager
@attribute [Authorize(Roles = AppRoles.Customer)]

<PageTitle>Referrals — Eco Meal</PageTitle>

<div class="container py-4">
<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1">Invite a friend</h1>
        <p class="text-muted small mb-0">
            Share your link — once your friend completes their first rescue, you both get store credit toward a future order.
        </p>
    </div>
    <a href="/" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Back
    </a>
</div>

@if (_info is null)
{
    <div class="d-flex justify-content-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else
{
    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <h6 class="fw-semibold mb-3">Your referral link</h6>
                    <div class="input-group">
                        <input type="text" class="form-control font-monospace small" readonly value="@ReferralLink" onclick="this.select();" id="referral-link"/>
                        <button type="button" class="btn btn-outline-secondary"
                                onclick="const el = document.getElementById('referral-link'); el.select(); navigator.clipboard.writeText(el.value); this.textContent = 'Copied!'; setTimeout(() => this.textContent = 'Copy', 1500);">
                            Copy
                        </button>
                    </div>
                    <p class="text-muted small mt-2 mb-0">Your code: <span class="font-monospace">@_info.ReferralCode</span></p>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <h6 class="fw-semibold mb-1">Store credit balance</h6>
                    <div class="display-6 fw-bold text-success mb-1">@_info.CreditBalance.ToString("C")</div>
                    <p class="text-muted small mb-0">Applied automatically at your next checkout, up to your basket total.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0">
            <h6 class="fw-semibold mb-0">Friends you've invited</h6>
        </div>
        @if (_info.Referrals.Count == 0)
        {
            <div class="text-center py-5">
                <div class="em-empty-icon"><i class="bi bi-people"></i></div>
                <p class="text-muted mb-0">No invites yet — share your link above to get started.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead>
                    <tr class="border-bottom">
                        <th class="px-4 py-3 text-uppercase text-muted small fw-semibold">Friend</th>
                        <th class="py-3 text-uppercase text-muted small fw-semibold">Joined</th>
                        <th class="py-3 text-uppercase text-muted small fw-semibold">Status</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var referral in _info.Referrals)
                    {
                        <tr>
                            <td class="px-4 fw-semibold">@referral.FriendName</td>
                            <td class="text-muted small">@referral.InvitedAt.ToString("MMM d, yyyy")</td>
                            <td>
                                @if (referral.Rewarded)
                                {
                                    <span class="badge rounded-pill text-bg-success">Reward earned</span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill text-bg-secondary">Waiting on first order</span>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
}
</div>

@code {
    private ReferralInfo? _info;

    private string ReferralLink => _info is null ? "" : $"{NavigationManager.BaseUri.TrimEnd('/')}/account/register?ref={_info.ReferralCode}";

    protected override async Task OnInitializedAsync()
    {
        _info = (await ReferralController.GetMyReferralInfoAsync()).Value;
    }
}
