@page "/brands/{Id:guid}"
@layout PublicLayout
@using Microsoft.AspNetCore.Components.Authorization
@using Netrom_Eco_Meal.Constants
@using Netrom_Eco_Meal.Controllers
@using Netrom_Eco_Meal.Entities
@using Netrom_Eco_Meal.Models
@using Netrom_Eco_Meal.Services
@rendermode InteractiveServer
@inject BrandController BrandController
@inject ClientTimeZoneService ClientTimeZoneService
@inject IJSRuntime JSRuntime

<PageTitle>@(_detail?.Brand.Name ?? "Brand") — Eco Meal</PageTitle>

@if (_detail is null && !_loading)
{
    <NotFoundPanel Title="Brand not found" Message="This brand no longer exists — it may have been removed." BackHref="/brands" BackLabel="Back to brands"/>
}
else if (_loading)
{
    <div class="d-flex justify-content-center py-5">
        <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div>
    </div>
}
else
{
    <div class="container py-4" style="max-width: 900px;">
        <a href="/brands" class="d-inline-block mb-3 text-decoration-none"><i class="bi bi-arrow-left"></i> Back to brands</a>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4">
                <div class="d-flex align-items-start justify-content-between gap-2 flex-wrap">
                    <div>
                        <h1 class="h3 fw-bold mb-1">@_detail!.Brand.Name</h1>
                        @if (!string.IsNullOrWhiteSpace(_detail.Brand.Description))
                        {
                            <p class="text-muted mb-2">@_detail.Brand.Description</p>
                        }
                        @if (_detail.RatingCount > 0)
                        {
                            <StarRating Value="@(_detail.AverageRating ?? 0)" ShowValue="true" Count="@_detail.RatingCount" Size="0.9rem"/>
                        }
                        <div class="text-muted small mt-1"><i class="bi bi-geo-alt me-1"></i>@_detail.Locations.Count location@(_detail.Locations.Count == 1 ? "" : "s")</div>
                    </div>
                    <AuthorizeView Roles="@AppRoles.Customer" Context="favAuth">
                        <Authorized>
                            <button type="button" class="btn @(_isFavorite ? "btn-primary" : "btn-outline-primary")" @onclick="ToggleFavoriteAsync">
                                <i class="bi @(_isFavorite ? "bi-heart-fill" : "bi-heart")"></i>
                                @(_isFavorite ? "Favorited" : "Favorite this brand")
                            </button>
                        </Authorized>
                    </AuthorizeView>
                </div>
            </div>
        </div>

        @if (NearestOpenLocation is { } nearest)
        {
            <a href="@($"/businesses/{nearest.Location.Id}")" class="text-decoration-none">
                <div class="alert alert-success d-flex align-items-center gap-2 mb-4">
                    <i class="bi bi-signpost-2-fill fs-5"></i>
                    <div>
                        <div class="fw-semibold">Nearest location open now: @nearest.Location.Name</div>
                        <div class="small">@(nearest.DistanceKm is { } km ? $"{km:0.0} km away — " : "")Order now &rarr;</div>
                    </div>
                </div>
            </a>
        }

        <h2 class="h6 fw-bold mb-3">Locations</h2>
        @if (_detail.Locations.Count == 0)
        {
            <p class="text-muted">No live locations right now.</p>
        }
        else
        {
            <div class="list-group">
                @foreach (var location in OrderedLocations)
                {
                    <a href="@($"/businesses/{location.Location.Id}")" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" @key="location.Location.Id">
                        <div>
                            <div class="fw-semibold">@location.Location.Name</div>
                            <div class="text-muted small"><i class="bi bi-geo-alt-fill me-1"></i>@location.Location.Address</div>
                        </div>
                        <div class="text-end">
                            @if (location.OpenNow is { } openNow)
                            {
                                <span class="badge @(openNow ? "text-bg-success" : "text-bg-secondary")">@(openNow ? "Open now" : "Closed now")</span>
                            }
                            @if (location.DistanceKm is { } distance)
                            {
                                <div class="text-muted small mt-1">@distance.ToString("0.0") km</div>
                            }
                        </div>
                    </a>
                }
            </div>
        }
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private BrandDetailDto? _detail;
    private bool _loading = true;
    private bool _isFavorite;
    private double? _lat;
    private double? _lng;

    private record LocationView(Business Location, bool? OpenNow, double? DistanceKm);

    protected override async Task OnInitializedAsync()
    {
        _detail = (await BrandController.GetPublicDetailAsync(Id)).Value;
        _loading = false;

        if (_detail is not null)
        {
            var favoriteIds = (await BrandController.GetMyFavoriteBrandIdsAsync()).Value ?? [];
            _isFavorite = favoriteIds.Contains(Id);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _detail is null || _detail.Locations.Count == 0)
            return;

        // Same belt-and-suspenders timeout as TripPlanner.razor — guarantees the page never hangs
        // waiting on a browser location prompt the customer just ignores.
        GeoPosition? position = null;
        try
        {
            var positionTask = JSRuntime.InvokeAsync<GeoPosition?>("EcoMeal.geo.getPosition").AsTask();
            if (await Task.WhenAny(positionTask, Task.Delay(TimeSpan.FromSeconds(10))) == positionTask)
                position = await positionTask;
        }
        catch (Exception)
        {
            position = null;
        }

        if (position is not null)
        {
            _lat = position.Lat;
            _lng = position.Lng;
            await InvokeAsync(StateHasChanged);
        }
    }

    private IEnumerable<LocationView> OrderedLocations
    {
        get
        {
            var localNow = ClientTimeZoneService.ToLocal(DateTime.UtcNow);
            var views = _detail!.Locations.Select(l => new LocationView(
                l,
                BusinessHoursStatus.IsOpenNow(l.Hours, l.Closures, localNow),
                _lat.HasValue && _lng.HasValue && l.Latitude.HasValue && l.Longitude.HasValue
                    ? GeoDistance.Km(_lat.Value, _lng.Value, l.Latitude.Value, l.Longitude.Value)
                    : null));

            return views.OrderByDescending(v => v.OpenNow == true).ThenBy(v => v.DistanceKm ?? double.MaxValue).ThenBy(v => v.Location.Name);
        }
    }

    // Routes a favoriting customer to whichever location is nearest and live right now — the
    // whole point of grouping locations under one brand rather than favoriting a single address.
    private LocationView? NearestOpenLocation =>
        _lat.HasValue && _lng.HasValue
            ? OrderedLocations.FirstOrDefault(v => v.OpenNow == true)
            : null;

    private async Task ToggleFavoriteAsync()
    {
        _isFavorite = (await BrandController.ToggleFavoriteAsync(Id)).Value;
    }

    private class GeoPosition
    {
        public double Lat { get; set; }
        public double Lng { get; set; }
    }
}
