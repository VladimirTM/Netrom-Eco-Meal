@page "/account/reset-password"
@layout EmptyLayout
@rendermode InteractiveServer
@using Netrom_Eco_Meal.Controllers
@inject AuthController AuthController

<PageTitle>Reset password — Eco Meal</PageTitle>

<div class="login-page">
    <div class="login-card">
        <div class="login-brand">
            <img src="logo.png" alt="Eco Meal" class="login-logo"/>
            <div>
                <div class="login-brand-name">Eco Meal</div>
                <div class="login-brand-sub">Surplus food, rescued</div>
            </div>
        </div>

        <h1 class="login-heading">Reset password</h1>

        @if (string.IsNullOrWhiteSpace(Email) || string.IsNullOrWhiteSpace(Token))
        {
            <div class="alert alert-danger py-2 small mb-3" role="alert">This reset link is invalid.</div>
        }
        else if (_succeeded)
        {
            <div class="alert alert-success py-2 small mb-3" role="alert">Your password has been reset.</div>
            <a class="btn btn-primary w-100 py-2 fw-semibold" href="/account/login">Sign in</a>
        }
        else
        {
            <div class="mb-4">
                <label class="form-label fw-semibold" for="reset-password">New password</label>
                <input id="reset-password" class="form-control" type="password" @bind="_newPassword"
                       placeholder="••••••••" minlength="8" autocomplete="new-password"/>
            </div>
            @if (_error is not null)
            {
                <div class="alert alert-danger py-2 small mb-3" role="alert">@_error</div>
            }
            <button class="btn btn-primary w-100 py-2 fw-semibold" disabled="@_busy" @onclick="SubmitAsync">
                @(_busy ? "Resetting…" : "Reset password")
            </button>
        }

        <p class="login-footer-link">
            <a href="/account/login">Back to sign in</a>
        </p>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? Email { get; set; }

    [SupplyParameterFromQuery]
    public string? Token { get; set; }

    private string _newPassword = "";
    private string? _error;
    private bool _busy;
    private bool _succeeded;

    private async Task SubmitAsync()
    {
        if (_newPassword.Length < 8)
        {
            _error = "Password must be at least 8 characters.";
            return;
        }

        _busy = true;
        _error = await AuthController.ResetPasswordAsync(Email!, Token!, _newPassword);
        _busy = false;
        _succeeded = _error is null;
    }
}
