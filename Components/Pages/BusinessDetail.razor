@page "/businesses/{Id:guid}"
@layout PublicLayout
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Mvc
@using Netrom_Eco_Meal.Constants
@using Netrom_Eco_Meal.Controllers
@using Netrom_Eco_Meal.Entities
@using Netrom_Eco_Meal.Models
@using Netrom_Eco_Meal.Services
@using Netrom_Eco_Meal.Services.Interfaces
@rendermode InteractiveServer
@implements IDisposable
@inject BusinessController BusinessController
@inject PackageController PackageController
@inject ReviewController ReviewController
@inject FavoriteController FavoriteController
@inject OrderController OrderController
@inject ReportController ReportController
@inject LoyaltyController LoyaltyController
@inject StandingOrderController StandingOrderController
@inject KitchenTipController KitchenTipController
@inject CartService CartService
@inject ClientTimeZoneService ClientTimeZoneService
@inject PackageStockBroadcaster PackageStockBroadcaster

<PageTitle>@(_business?.Name ?? "Business") — Eco Meal</PageTitle>

@if (_business is null && !_loading)
{
    <NotFoundPanel Title="Business not found" Message="This kitchen no longer exists — it may have closed or been removed." BackHref="/" BackLabel="Back to home"/>
}
else if (_loading)
{
    <div class="biz-modal-loading">
        <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div>
    </div>
}
else
{
    <div class="biz-page">
        <a href="/" class="biz-page-back"><i class="bi bi-arrow-left"></i> Back to all kitchens</a>

        <div class="biz-page-card">
            <div class="biz-modal-hero" style="@HeroStyle">
                <div class="biz-modal-hero-overlay">
                    <span class="biz-modal-eyebrow">@_business!.BusinessType.Name</span>
                    <div class="d-flex align-items-start justify-content-between gap-2">
                        <h1 class="biz-modal-title" id="biz-modal-title">@_business.Name</h1>
                        <div class="d-flex align-items-center gap-2">
                            <AuthorizeView Roles="@AppRoles.Customer" Context="favAuth">
                                <Authorized>
                                    <button type="button" class="biz-modal-fav-btn @(_isFavorite ? "biz-modal-fav-active" : "")" @onclick="ToggleFavoriteAsync">
                                        <i class="bi @(_isFavorite ? "bi-heart-fill" : "bi-heart")"></i>
                                        @(_isFavorite ? "Favorited" : "Favorite")
                                    </button>
                                    <button type="button" class="biz-modal-fav-btn" title="Report this kitchen" @onclick="() => { _reportTipId = null; _reportPromptOpen = true; }">
                                        <i class="bi bi-flag"></i>
                                    </button>
                                </Authorized>
                            </AuthorizeView>
                        </div>
                    </div>
                    <div class="biz-modal-meta">
                        @if (_business.Brand is not null)
                        {
                            <a href="@($"/brands/{_business.Brand.Id}")" class="biz-modal-open-badge biz-modal-open-badge-open text-decoration-none">
                                <i class="bi bi-diagram-3"></i> Part of @_business.Brand.Name
                            </a>
                        }
                        <span class="biz-modal-address"><i class="bi bi-geo-alt-fill"></i>@_business.Address</span>
                        @if (OpenNow is { } openNow)
                        {
                            <span class="biz-modal-open-badge @(openNow ? "biz-modal-open-badge-open" : "biz-modal-open-badge-closed")">
                                <span class="biz-modal-open-dot"></span>@(openNow ? "Open now" : "Closed now")
                            </span>
                        }
                        @if (_reviews.Count > 0)
                        {
                            <StarRating Value="@AverageRating" ShowValue="true" Count="@_reviews.Count" Size="0.8rem"/>
                        }
                    </div>
                </div>
            </div>

            <div class="biz-modal-body">
                <p class="biz-modal-desc">@_business.Description</p>

                <AuthorizeView Roles="@AppRoles.Customer" Context="loyaltyAuth">
                    <Authorized>
                        @if (_loyaltyProgress is not null)
                        {
                            <div class="biz-modal-inline-toast">
                                <i class="bi bi-award-fill"></i>
                                @(_loyaltyProgress.OrdersUntilReward == 1
                                    ? $"1 more completed order this month unlocks {_loyaltyProgress.DiscountAmount.ToString("C")} off your next order here!"
                                    : $"{_loyaltyProgress.OrdersUntilReward} more completed orders this month unlock {_loyaltyProgress.DiscountAmount.ToString("C")} off your next order here!")
                            </div>
                        }
                    </Authorized>
                </AuthorizeView>

                @if (_toastMessage is not null)
                {
                    <div class="biz-modal-inline-toast" @key="_toastToken">
                        <i class="bi bi-check-circle-fill"></i> @_toastMessage
                    </div>
                }

                @if (_business.Hours.Count > 0 || _business.Closures.Count > 0)
                {
                    <div class="biz-modal-divider"></div>

                    <section class="biz-modal-section">
                        <h3 class="biz-modal-section-title"><i class="bi bi-clock-history"></i> Opening hours</h3>

                        @if (ActiveClosure is { } closure)
                        {
                            <div class="biz-modal-closure-notice">
                                <i class="bi bi-calendar-x"></i>
                                Closed for the holidays until @closure.EndDate.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)@(string.IsNullOrWhiteSpace(closure.Reason) ? "." : $" — {closure.Reason}")
                            </div>
                        }

                        @if (_business.Hours.Count > 0)
                        {
                            <ul class="biz-hours-list">
                                @foreach (var day in WeekOrder)
                                {
                                    var row = _business.Hours.FirstOrDefault(h => h.DayOfWeek == day);
                                    var isToday = day == ClientTimeZoneService.ToLocal(DateTime.UtcNow).DayOfWeek;
                                    <li class="biz-hours-row @(isToday ? "biz-hours-row-today" : "")">
                                        <span>@day</span>
                                        <span>@HoursLabel(row)</span>
                                    </li>
                                }
                            </ul>
                        }
                    </section>
                }

                <div class="biz-modal-divider"></div>

                <section class="biz-modal-section">
                    <h3 class="biz-modal-section-title">
                        <i class="bi bi-bag-check"></i> What's available
                        <span class="biz-live-badge" title="Stock updates automatically while you browse"><span class="biz-card-live-dot"></span>Live</span>
                    </h3>

                    @if (_loadingPackages)
                    {
                        <div class="d-flex justify-content-center py-4">
                            <div class="spinner-border spinner-border-sm text-primary" role="status"><span class="visually-hidden">Loading...</span></div>
                        </div>
                    }
                    else if (_packages.Count == 0)
                    {
                        <p class="biz-modal-empty">Nothing live from this kitchen right now — check back later.</p>
                    }
                    else
                    {
                        <div class="biz-pkg-list">
                            @foreach (var package in _packages)
                            {
                                var available = CartService.AvailableQuantity(package, _reservedByPackage.GetValueOrDefault(package.Id));
                                <div class="biz-pkg-row biz-pkg-row-clickable" @onclick="() => _selectedPackage = package">
                                    <div class="biz-pkg-info">
                                        <div class="biz-pkg-name">@package.Name</div>
                                        <div class="biz-pkg-meta">
                                            <span class="biz-pkg-type">@package.PackageType.Name</span>
                                            <span>&middot;</span>
                                            <span><i class="bi bi-clock"></i>@PickupLabel(package)</span>
                                            @if (ClosingSoonBadge(package) is { } closingSoon)
                                            {
                                                <span class="biz-pkg-closing-badge"><i class="bi bi-alarm-fill"></i>@closingSoon</span>
                                            }
                                        </div>
                                        <p class="biz-pkg-desc">@package.Description</p>
                                        @if (package.DietaryTags.Count > 0)
                                        {
                                            <div class="diet-tag-row">
                                                @foreach (var tag in package.DietaryTags)
                                                {
                                                    <span class="diet-tag @(Netrom_Eco_Meal.Constants.DietaryTags.IsAllergen(tag) ? "diet-tag-allergen" : "")">@tag</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                    <div class="biz-pkg-side">
                                        <div class="biz-pkg-price">@package.Price.ToString("C")</div>
                                        <div class="biz-pkg-qty">@available left</div>
                                        <AuthorizeView Roles="@AppRoles.Customer" Context="cartAuth">
                                            <Authorized>
                                                @if (available <= 0)
                                                {
                                                    <button type="button" class="biz-pkg-add-btn" disabled @onclick:stopPropagation="true">Sold out</button>
                                                }
                                                else
                                                {
                                                    <button type="button" class="biz-pkg-add-btn" @onclick="() => AddToCart(package)" @onclick:stopPropagation="true">
                                                        <i class="bi bi-bag-plus"></i> Add
                                                    </button>
                                                }
                                            </Authorized>
                                        </AuthorizeView>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </section>

                <AuthorizeView Roles="@AppRoles.Customer" Context="standingAuth">
                    <Authorized>
                        <div class="biz-modal-divider"></div>

                        <section class="biz-modal-section">
                            <h3 class="biz-modal-section-title"><i class="bi bi-arrow-repeat"></i> Standing order</h3>

                            @if (_myStandingOrder is null)
                            {
                                <p class="biz-modal-review-hint">Save your usual here — we'll add it to your basket and notify you the moment it's back, up to a weekly budget you set.</p>
                                <div class="row g-2 align-items-end">
                                    <div class="col-sm-4">
                                        <label class="form-label small">Package type <span class="text-muted">(optional)</span></label>
                                        <select class="form-select form-select-sm" @bind="_newStandingPackageTypeIdText">
                                            <option value="">Any type</option>
                                            @foreach (var type in _businessPackageTypes)
                                            {
                                                <option value="@type.Id">@type.Name</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-sm-4">
                                        <label class="form-label small">Dietary tag <span class="text-muted">(optional)</span></label>
                                        <select class="form-select form-select-sm" @bind="_newStandingDietaryTag">
                                            <option value="">Any</option>
                                            @foreach (var tag in DietaryTags.All)
                                            {
                                                <option value="@tag">@tag</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-sm-3">
                                        <label class="form-label small">Weekly budget</label>
                                        <div class="input-group input-group-sm">
                                            <input type="number" min="1" step="0.5" class="form-control" @bind="_newStandingBudget"/>
                                            <span class="input-group-text">lei</span>
                                        </div>
                                    </div>
                                    <div class="col-sm-1">
                                        <button type="button" class="btn btn-primary btn-sm w-100" disabled="@_savingStandingOrder" @onclick="CreateStandingOrderAsync">
                                            @if (_savingStandingOrder)
                                            {
                                                <span class="spinner-border spinner-border-sm" role="status"></span>
                                            }
                                            else
                                            {
                                                <span>Save</span>
                                            }
                                        </button>
                                    </div>
                                </div>
                                @if (_standingOrderError is not null)
                                {
                                    <div class="text-danger small mt-1">@_standingOrderError</div>
                                }
                            }
                            else
                            {
                                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                                    <div class="small">
                                        <strong>@(_myStandingOrder.PackageType?.Name ?? "Any package")</strong>@(_myStandingOrder.DietaryTag is null ? "" : $" · {_myStandingOrder.DietaryTag}")
                                        — up to @_myStandingOrder.MaxWeeklySpend.ToString("C")/week
                                        <span class="badge @(_myStandingOrder.IsActive ? "bg-success" : "bg-secondary") ms-2">@(_myStandingOrder.IsActive ? "Active" : "Paused")</span>
                                    </div>
                                    <div class="d-flex gap-2">
                                        <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@_savingStandingOrder" @onclick="ToggleStandingOrderAsync">
                                            @(_myStandingOrder.IsActive ? "Pause" : "Resume")
                                        </button>
                                        <button type="button" class="btn btn-outline-danger btn-sm" disabled="@_savingStandingOrder" @onclick="DeleteStandingOrderAsync">Remove</button>
                                    </div>
                                </div>
                            }
                        </section>
                    </Authorized>
                </AuthorizeView>

                <div class="biz-modal-divider"></div>

                <section class="biz-modal-section">
                    <h3 class="biz-modal-section-title"><i class="bi bi-chat-square-text"></i> Reviews</h3>

                    <AuthorizeView Roles="@AppRoles.Customer" Context="reviewAuth">
                        <Authorized>
                            @if (_reviewContext is { CanReview: true })
                            {
                                <div class="biz-review-form">
                                    <span class="biz-review-form-label">@(_reviewContext.MyReview is null ? "Leave a review" : "Update your review")</span>
                                    <StarRating Editable="true" SelectedValue="_reviewRating" SelectedValueChanged="v => _reviewRating = v" Size="1.4rem"/>
                                    @if (_reviewContext.ReviewablePackages.Count > 0)
                                    {
                                        <select class="form-select form-select-sm biz-review-package-select" @bind="_reviewPackageIdText">
                                            <option value="">Whole kitchen (no specific package)</option>
                                            @foreach (var package in _reviewContext.ReviewablePackages)
                                            {
                                                <option value="@package.Id">@package.Name</option>
                                            }
                                        </select>
                                    }
                                    <textarea class="form-control biz-review-textarea" rows="2" maxlength="600"
                                              placeholder="What did you think? (optional)" @bind="_reviewComment"></textarea>
                                    @if (_reviewError is not null)
                                    {
                                        <div class="alert alert-danger py-2 small mb-0">@_reviewError</div>
                                    }
                                    <button type="button" class="btn btn-primary btn-sm align-self-start" disabled="@(_reviewRating < 1 || _submittingReview)" @onclick="SubmitReviewAsync">
                                        @if (_submittingReview)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                        }
                                        @(_reviewContext.MyReview is null ? "Submit review" : "Update review")
                                    </button>
                                </div>
                            }
                            else
                            {
                                <p class="biz-modal-review-hint">Order from @_business.Name and come back to leave a review.</p>
                            }
                        </Authorized>
                    </AuthorizeView>

                    @if (_reviews.Count == 0)
                    {
                        <p class="biz-modal-empty">No reviews yet — be the first to rescue a meal here.</p>
                    }
                    else
                    {
                        <div class="biz-review-list">
                            @foreach (var review in _reviews)
                            {
                                <div class="biz-review-card">
                                    <div class="biz-review-avatar">@TextHelpers.GetInitial(review.User.Name)</div>
                                    <div class="biz-review-content">
                                        <div class="biz-review-top">
                                            <span class="biz-review-name">@review.User.Name</span>
                                            <span class="biz-review-date">@ClientTimeZoneService.ToLocal(review.CreatedAt).ToString("MMM d, yyyy", CultureInfo.InvariantCulture)</span>
                                        </div>
                                        <div class="d-flex align-items-center gap-2 flex-wrap">
                                            <StarRating Value="@review.Rating" Size="0.75rem"/>
                                            @if (review.Package is not null)
                                            {
                                                <span class="biz-review-package-tag">@review.Package.Name</span>
                                            }
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(review.Comment))
                                        {
                                            <p class="biz-review-comment">@review.Comment</p>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </section>

                <div class="biz-modal-divider"></div>

                <section class="biz-modal-section">
                    <h3 class="biz-modal-section-title"><i class="bi bi-lightbulb"></i> Kitchen tips</h3>
                    <p class="biz-modal-review-hint mt-0">Practical hints from other rescuers — parking, entrance, best time to show up.</p>

                    <AuthorizeView Roles="@AppRoles.Customer" Context="tipAuth">
                        <Authorized>
                            <div class="biz-review-form">
                                <textarea class="form-control biz-review-textarea" rows="2" maxlength="@KitchenTips.MaxLength"
                                          placeholder="e.g. Use the side door after 8pm" @bind="_newTipText" @bind:event="oninput"></textarea>
                                @if (_tipError is not null)
                                {
                                    <div class="alert alert-danger py-2 small mb-0">@_tipError</div>
                                }
                                <button type="button" class="btn btn-primary btn-sm align-self-start" disabled="@(string.IsNullOrWhiteSpace(_newTipText) || _submittingTip)" @onclick="SubmitTipAsync">
                                    @if (_submittingTip)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                    }
                                    Share tip
                                </button>
                            </div>
                        </Authorized>
                    </AuthorizeView>

                    @if (_kitchenTips.Count == 0)
                    {
                        <p class="biz-modal-empty">No tips yet — share the first one.</p>
                    }
                    else
                    {
                        <div class="biz-review-list">
                            @foreach (var tip in _kitchenTips)
                            {
                                <div class="biz-review-card" @key="tip.Id">
                                    <div class="biz-review-avatar">@TextHelpers.GetInitial(tip.User.Name)</div>
                                    <div class="biz-review-content">
                                        <div class="biz-review-top">
                                            <span class="biz-review-name">@tip.User.Name</span>
                                            <span class="biz-review-date">@ClientTimeZoneService.ToLocal(tip.CreatedAt).ToString("MMM d, yyyy", CultureInfo.InvariantCulture)</span>
                                        </div>
                                        <p class="biz-review-comment mb-0">@tip.Tip</p>
                                    </div>
                                    <AuthorizeView>
                                        <Authorized>
                                            <button type="button" class="btn btn-link btn-sm text-muted p-0" title="Report this tip" @onclick="() => RequestReportTip(tip.Id)">
                                                <i class="bi bi-flag"></i>
                                            </button>
                                        </Authorized>
                                    </AuthorizeView>
                                </div>
                            }
                        </div>
                    }
                </section>
            </div>
        </div>
    </div>
}

<PackageDetailModal Package="_selectedPackage"
                     AvailableQuantity="@(_selectedPackage is null ? 0 : CartService.AvailableQuantity(_selectedPackage, _reservedByPackage.GetValueOrDefault(_selectedPackage.Id)))"
                     PickupLabel="@(_selectedPackage is null ? "" : PickupLabel(_selectedPackage))"
                     ClosingSoonLabel="@(_selectedPackage is null ? null : ClosingSoonBadge(_selectedPackage))"
                     RatingAverage="@(_selectedPackage is null ? 0 : PackageRatingAverage(_selectedPackage.Id))"
                     ReviewCount="@(_selectedPackage is null ? 0 : PackageReviews(_selectedPackage.Id).Count)"
                     OnClose="() => _selectedPackage = null"
                     OnAddToCart="AddToCart"/>

<ReportDialog IsOpen="_reportPromptOpen"
              TargetLabel="@(_reportTipId is null ? (_business?.Name ?? "") : "this tip")"
              Busy="@_reportBusy"
              OnSubmit="SubmitReportAsync"
              OnCancel="() => { _reportPromptOpen = false; _reportTipId = null; }"/>

<ConfirmDialog IsOpen="@(_pendingSwitch is not null)"
               Title="Start a new basket?"
               Message="@SwitchMessage"
               ConfirmLabel="Start new basket"
               CancelLabel="Keep current basket"
               ConfirmClass="btn-primary"
               Busy="@_switchingBasket"
               OnConfirm="ConfirmSwitchBasketAsync"
               OnCancel="() => _pendingSwitch = null"/>

@code {
    [Parameter] public Guid Id { get; set; }

    // Set by StandingOrderService's post-generation match notification link — auto-adds the
    // matched package to the customer's basket so "confirm" is just clicking Pay.
    [SupplyParameterFromQuery(Name = "reserve")]
    public Guid? ReservePackageId { get; set; }

    private bool _loading = true;
    private Business? _business;
    private List<Package> _packages = [];
    private bool _loadingPackages;
    private List<Review> _reviews = [];
    private ReviewContext? _reviewContext;
    private int _reviewRating;
    private string _reviewComment = "";
    private string _reviewPackageIdText = "";
    private bool _submittingReview;
    private string? _reviewError;
    private string? _toastMessage;
    private Guid _toastToken;
    private Package? _pendingSwitch;
    private bool _switchingBasket;
    private Package? _selectedPackage;
    private bool _isFavorite;
    private Dictionary<Guid, int> _reservedByPackage = [];
    private bool _reportPromptOpen;
    private bool _reportBusy;
    // Non-null while the report dialog targets a specific kitchen tip rather than the business
    // itself — see RequestReportTip/SubmitReportAsync.
    private Guid? _reportTipId;
    private List<KitchenTip> _kitchenTips = [];
    private string _newTipText = "";
    private bool _submittingTip;
    private string? _tipError;
    private LoyaltyProgress? _loyaltyProgress;
    private List<StandingOrder> _myStandingOrders = [];
    private List<PackageType> _businessPackageTypes = [];
    private string _newStandingPackageTypeIdText = "";
    private string _newStandingDietaryTag = "";
    private decimal _newStandingBudget = 20m;
    private bool _savingStandingOrder;
    private string? _standingOrderError;

    private StandingOrder? _myStandingOrder => _myStandingOrders.FirstOrDefault(s => s.BusinessId == Id);

    private static readonly DayOfWeek[] WeekOrder =
        [DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday, DayOfWeek.Saturday, DayOfWeek.Sunday];

    private double AverageRating => _reviews.Count == 0 ? 0 : _reviews.Average(r => r.Rating);

    // Null when hours aren't configured yet — the badge hides rather than guessing.
    private bool? OpenNow => _business is null
        ? null
        : BusinessHoursStatus.IsOpenNow(_business.Hours, _business.Closures, ClientTimeZoneService.ToLocal(DateTime.UtcNow));

    private BusinessClosure? ActiveClosure => _business is null
        ? null
        : BusinessHoursStatus.ActiveClosure(_business.Closures, ClientTimeZoneService.ToLocal(DateTime.UtcNow));

    private static string HoursLabel(BusinessHours? row) =>
        row is null or { IsClosed: true } ? "Closed" : $"{row.OpenTime:HH:mm}–{row.CloseTime:HH:mm}";

    // background-color stays set even when a URL is present, so a broken/unreachable image
    // falls back to the forest placeholder instead of blank white (see Home.razor's MediaStyle).
    private string HeroStyle => string.IsNullOrWhiteSpace(_business?.ImageUrl)
        ? "background-color: var(--em-forest);"
        : $"background-color: var(--em-forest); background-image: linear-gradient(180deg, rgba(11,31,19,0.15) 0%, rgba(11,31,19,0.85) 100%), url('{_business.ImageUrl}');";

    private string SwitchMessage => _pendingSwitch is null ? "" :
        $"Your basket has items from {CartService.BusinessName}. Adding \"{_pendingSwitch.Name}\" from {_pendingSwitch.Business.Name} will clear it and start a new one.";

    protected override void OnInitialized()
    {
        CartService.OnChange += HandleCartChanged;
        ClientTimeZoneService.OnChange += HandleTimeZoneChanged;
        PackageStockBroadcaster.BusinessStockChanged += HandleStockChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        var business = (await BusinessController.GetByIdAsync(Id)).Value;
        // A pending/rejected application or a hidden business isn't a public storefront page —
        // the admin/staff-facing views (/businesses, /businesses/edit/{id}) cover those instead.
        _business = business is { Status: BusinessStatuses.Approved, IsHidden: false } ? business : null;
        _loading = false;

        if (_business is null)
            return;

        var favoriteIds = (await FavoriteController.GetMyFavoriteBusinessIdsAsync()).Value ?? [];
        _isFavorite = favoriteIds.Contains(Id);

        _loadingPackages = true;
        StateHasChanged();

        await LoadPackagesAsync();
        _loadingPackages = false;

        _businessPackageTypes = _packages.Select(p => p.PackageType).DistinctBy(t => t.Id).OrderBy(t => t.Name).ToList();
        _loyaltyProgress = (await LoyaltyController.GetMyProgressAsync(Id)).Value;
        _myStandingOrders = (await StandingOrderController.GetMyStandingOrdersAsync()).Value ?? [];

        await TryAutoReserveAsync();
        await ReloadReviewsAsync(Id);
        await ReloadKitchenTipsAsync(Id);
    }

    // Fired from a "your usual is live" notification link — only steps in when it's safe to,
    // never overriding an in-progress basket from a different kitchen.
    private async Task TryAutoReserveAsync()
    {
        if (ReservePackageId is not { } reserveId)
            return;

        var package = _packages.FirstOrDefault(p => p.Id == reserveId);
        if (package is null || CartService.InCartQuantity(package.Id) > 0 || CartService.WouldReplaceCart(package))
            return;

        var available = CartService.AvailableQuantity(package, _reservedByPackage.GetValueOrDefault(package.Id));
        if (available <= 0)
            return;

        await CartService.AddAsync(package);
        _toastMessage = $"Reserved your usual — \"{package.Name}\" is in your basket.";
        _toastToken = Guid.NewGuid();
    }

    private async Task LoadPackagesAsync()
    {
        var paged = (await PackageController.GetPagedAsync(1, 100, null, Id, null)).Value;
        _packages = paged?.Items
            .Where(p => p.PickupEnd > DateTime.UtcNow && !p.IsHidden)
            .OrderBy(p => p.PickupEnd)
            .ToList() ?? [];
        _reservedByPackage = (await OrderController.GetPendingReservedQuantitiesAsync(_packages.Select(p => p.Id))).Value ?? [];

        // Keep the open detail modal (if any) pointed at the freshly-loaded package instance so its
        // "left"/"Sold out" state updates live too — closes itself if the package dropped out of the
        // live list entirely (hidden, deleted, or its pickup window just closed).
        if (_selectedPackage is not null)
            _selectedPackage = _packages.FirstOrDefault(p => p.Id == _selectedPackage.Id);
    }

    // The broadcaster is a singleton shared by every open BusinessDetail.razor circuit, so this
    // fires for changes on *any* business — filter to our own before doing anything.
    private void HandleStockChanged(Guid businessId)
    {
        if (businessId != Id)
            return;

        // The broadcaster calls us synchronously and can be THIS circuit (the cart panel starting
        // a Rescue Circle is an overlay on this very page) — InvokeAsync would then run inline,
        // reentrantly, racing LoadPackagesAsync's DbContext use against the order-placing code
        // still further up this same call stack. Task.Run first guarantees we're never still on
        // the caller's thread, so InvokeAsync always genuinely queues instead.
        _ = Task.Run(async () =>
        {
            try
            {
                await InvokeAsync(async () =>
                {
                    await LoadPackagesAsync();
                    StateHasChanged();
                });
            }
            catch (Exception)
            {
            }
        });
    }

    private async Task ReloadReviewsAsync(Guid businessId)
    {
        _reviews = (await ReviewController.GetByBusinessAsync(businessId)).Value ?? [];
        _reviewContext = (await ReviewController.GetContextAsync(businessId)).Value;

        if (_reviewContext?.MyReview is { } mine)
        {
            _reviewRating = mine.Rating;
            _reviewComment = mine.Comment ?? "";
            _reviewPackageIdText = mine.PackageId?.ToString() ?? "";
        }
    }

    private string PickupLabel(Package package)
    {
        var start = ClientTimeZoneService.ToLocal(package.PickupStart);
        var end = ClientTimeZoneService.ToLocal(package.PickupEnd);
        return FormattableString.Invariant($"{start:MMM d} · {start:HH:mm}–{end:HH:mm}");
    }

    // Same "closing soon" window the home page's business sort cares about, just surfaced per
    // package instead of only affecting sort order.
    private const int ClosingSoonThresholdMinutes = 60;

    private string? ClosingSoonBadge(Package package)
    {
        var remaining = package.PickupEnd - DateTime.UtcNow;
        if (remaining <= TimeSpan.Zero || remaining > TimeSpan.FromMinutes(ClosingSoonThresholdMinutes))
            return null;

        var minutes = Math.Max(1, (int)Math.Ceiling(remaining.TotalMinutes));
        return $"Ends in {minutes} min";
    }

    private List<Review> PackageReviews(Guid packageId) => _reviews.Where(r => r.PackageId == packageId).ToList();

    private double PackageRatingAverage(Guid packageId)
    {
        var reviews = PackageReviews(packageId);
        return reviews.Count == 0 ? 0 : reviews.Average(r => r.Rating);
    }

    private async Task AddToCart(Package package)
    {
        if (CartService.WouldReplaceCart(package))
        {
            _pendingSwitch = package;
            return;
        }

        await CartService.AddAsync(package);
        _toastMessage = $"Added \"{package.Name}\" to your basket.";
        _toastToken = Guid.NewGuid();
        _selectedPackage = null;
    }

    private async Task ToggleFavoriteAsync()
    {
        _isFavorite = (await FavoriteController.ToggleFavoriteAsync(Id)).Value;
    }

    private async Task SubmitReportAsync(string reason)
    {
        if (string.IsNullOrWhiteSpace(reason))
            return;

        _reportBusy = true;
        var result = _reportTipId is { } tipId
            ? await ReportController.SubmitAsync(AuditTargetTypes.KitchenTip, tipId, reason)
            : await ReportController.SubmitAsync(AuditTargetTypes.Business, Id, reason);
        _reportBusy = false;
        _reportPromptOpen = false;
        _reportTipId = null;

        _toastMessage = result is UnauthorizedResult
            ? "You must be signed in to report something."
            : "Thanks — an admin will take a look.";
        _toastToken = Guid.NewGuid();
    }

    private void RequestReportTip(Guid tipId)
    {
        _reportTipId = tipId;
        _reportPromptOpen = true;
    }

    private async Task ReloadKitchenTipsAsync(Guid businessId)
    {
        _kitchenTips = (await KitchenTipController.GetByBusinessAsync(businessId)).Value ?? [];
    }

    private async Task SubmitTipAsync()
    {
        if (_business is null || string.IsNullOrWhiteSpace(_newTipText) || _submittingTip)
            return;

        _submittingTip = true;
        _tipError = null;
        var result = await KitchenTipController.SubmitAsync(_business.Id, _newTipText);
        _submittingTip = false;

        if (result is ConflictObjectResult conflict)
        {
            _tipError = conflict.Value?.ToString() ?? "We couldn't save your tip. Please try again.";
            return;
        }

        _newTipText = "";
        await ReloadKitchenTipsAsync(_business.Id);
    }

    private async Task ConfirmSwitchBasketAsync()
    {
        if (_pendingSwitch is null)
            return;

        var package = _pendingSwitch;
        _switchingBasket = true;
        await CartService.AddAsync(package);
        _switchingBasket = false;
        _pendingSwitch = null;
        _selectedPackage = null;

        _toastMessage = $"Started a new basket from {package.Business.Name} — your previous items were cleared.";
        _toastToken = Guid.NewGuid();
    }

    private async Task SubmitReviewAsync()
    {
        if (_business is null || _reviewRating < 1 || _submittingReview)
            return;

        _submittingReview = true;
        _reviewError = null;
        Guid? packageId = Guid.TryParse(_reviewPackageIdText, out var id) ? id : null;
        var result = await ReviewController.SubmitAsync(_business.Id, _reviewRating, _reviewComment, packageId);
        _submittingReview = false;

        if (result is ConflictObjectResult conflict)
        {
            _reviewError = conflict.Value?.ToString() ?? "We couldn't save your review. Please try again.";
            return;
        }

        await ReloadReviewsAsync(_business.Id);
    }

    private async Task CreateStandingOrderAsync()
    {
        _standingOrderError = null;
        _savingStandingOrder = true;

        Guid? packageTypeId = Guid.TryParse(_newStandingPackageTypeIdText, out var typeId) ? typeId : null;
        string? dietaryTag = string.IsNullOrWhiteSpace(_newStandingDietaryTag) ? null : _newStandingDietaryTag;
        var result = await StandingOrderController.CreateAsync(Id, packageTypeId, dietaryTag, _newStandingBudget);
        _savingStandingOrder = false;

        if (result.Result is ConflictObjectResult conflict)
        {
            _standingOrderError = conflict.Value?.ToString() ?? "We couldn't save your standing order.";
            return;
        }

        if (result.Value is { } created)
        {
            // CreateAsync's response has no PackageType nav loaded — patch it from the business's
            // own package types (already loaded here) so the confirmation shows the real type,
            // not "Any package".
            created.PackageType = _businessPackageTypes.FirstOrDefault(t => t.Id == created.PackageTypeId);
            _myStandingOrders.Add(created);
        }
    }

    private async Task ToggleStandingOrderAsync()
    {
        if (_myStandingOrder is not { } standing)
            return;

        _savingStandingOrder = true;
        await StandingOrderController.UpdateAsync(standing.Id, standing.MaxWeeklySpend, !standing.IsActive);
        _savingStandingOrder = false;
        standing.IsActive = !standing.IsActive;
    }

    private async Task DeleteStandingOrderAsync()
    {
        if (_myStandingOrder is not { } standing)
            return;

        _savingStandingOrder = true;
        await StandingOrderController.DeleteAsync(standing.Id);
        _savingStandingOrder = false;
        _myStandingOrders.RemoveAll(s => s.Id == standing.Id);
    }

    private void HandleCartChanged() => InvokeAsync(StateHasChanged);

    private void HandleTimeZoneChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        CartService.OnChange -= HandleCartChanged;
        ClientTimeZoneService.OnChange -= HandleTimeZoneChanged;
        PackageStockBroadcaster.BusinessStockChanged -= HandleStockChanged;
    }
}
