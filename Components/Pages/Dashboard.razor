@page "/dashboard"
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Mvc
@using Microsoft.EntityFrameworkCore
@using Netrom_Eco_Meal.Constants
@using Netrom_Eco_Meal.Controllers
@using Netrom_Eco_Meal.Entities
@using Netrom_Eco_Meal.Services
@using Netrom_Eco_Meal.Services.Interfaces
@rendermode InteractiveServer
@implements IDisposable
@inject BusinessController BusinessController
@inject PackageController PackageController
@inject OrderController OrderController
@inject IBusinessService BusinessService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject ManagedBusinessContext ManagedBusinessContext
@inject ClientTimeZoneService ClientTimeZoneService
@attribute [Authorize(Roles = $"{AppRoles.Admin},{AppRoles.BusinessManager}")]

<PageTitle>Dashboard — Eco Meal</PageTitle>

<div class="mb-4">
    <h1 class="h3 fw-bold mb-1">Dashboard</h1>
    <p class="text-muted small mb-0">Welcome to the Eco Meal Admin Panel</p>
</div>

<div class="row g-3 mb-4">
    @if (_isAdmin)
    {
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 card-accent-green">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-primary bg-opacity-10 text-primary">
                        <i class="bi bi-building fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Businesses</div>
                        @if (_businessCount is null)
                        {
                            <div class="spinner-border spinner-border-sm text-primary mt-1" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        }
                        else
                        {
                            <div class="fw-bold fs-4">@_businessCount</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100 card-accent-blue">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-3 p-3 bg-sky-subtle text-sky">
                    <i class="bi bi-box-seam fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small">@(_isAdmin ? "Packages" : "Your Packages")</div>
                    @if (_packageCount is null)
                    {
                        <div class="spinner-border spinner-border-sm text-sky mt-1" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    }
                    else
                    {
                        <div class="fw-bold fs-4">@_packageCount</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100 card-accent-amber">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-3 p-3 bg-warning bg-opacity-10 text-warning">
                    <i class="bi bi-cart3 fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small">Orders</div>
                    @if (_ordersUnavailable)
                    {
                        <div class="fw-bold fs-6 text-muted">Not assigned</div>
                    }
                    else if (_orderCount is null)
                    {
                        <div class="spinner-border spinner-border-sm text-warning mt-1" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    }
                    else
                    {
                        <div class="fw-bold fs-4">@_orderCount</div>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (_isAdmin)
    {
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 card-accent-purple">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-purple-subtle text-purple">
                        <i class="bi bi-people fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Users</div>
                        @if (_userCount is null)
                        {
                            <div class="spinner-border spinner-border-sm text-purple mt-1" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        }
                        else
                        {
                            <div class="fw-bold fs-4">@_userCount</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0">
        <h6 class="fw-semibold mb-0">Last 14 days</h6>
    </div>
    <div class="card-body px-4 pb-4">
        @if (_ordersUnavailable)
        {
            <p class="text-muted small mb-0">You don't manage a business yet, so there's no trend to show.</p>
        }
        else if (_dailyStats is null)
        {
            <div class="d-flex justify-content-center py-4">
                <div class="spinner-border spinner-border-sm text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        }
        else
        {
            <div class="dash-trend-row">
                <span class="dash-trend-label">Orders</span>
                <div class="dash-trend-chart">
                    @for (var i = 0; i < _dailyStats.Count; i++)
                    {
                        var day = _dailyStats[i];
                        var isToday = i == _dailyStats.Count - 1;
                        <div class="dash-trend-bar-wrap @(isToday ? "dash-trend-bar-wrap-today" : "")" tabindex="0"
                             aria-label="@day.Date.ToString("MMM d"): @day.OrderCount order@(day.OrderCount == 1 ? "" : "s")">
                            <span class="dash-trend-tooltip">
                                <span class="dash-trend-tooltip-date">@(isToday ? "Today" : day.Date.ToString("MMM d"))</span>
                                <span class="dash-trend-tooltip-value">@day.OrderCount order@(day.OrderCount == 1 ? "" : "s")</span>
                            </span>
                            <div class="dash-trend-bar dash-trend-bar-orders" style="height: @(BarHeightPx(day.OrderCount, _maxOrderCount))px"></div>
                        </div>
                    }
                </div>
            </div>
            <div class="dash-trend-row">
                <span class="dash-trend-label">Kg saved</span>
                <div class="dash-trend-chart">
                    @for (var i = 0; i < _dailyStats.Count; i++)
                    {
                        var day = _dailyStats[i];
                        var isToday = i == _dailyStats.Count - 1;
                        <div class="dash-trend-bar-wrap @(isToday ? "dash-trend-bar-wrap-today" : "")" tabindex="0"
                             aria-label="@day.Date.ToString("MMM d"): @day.KgSaved.ToString("0.#") kg saved">
                            <span class="dash-trend-tooltip">
                                <span class="dash-trend-tooltip-date">@(isToday ? "Today" : day.Date.ToString("MMM d"))</span>
                                <span class="dash-trend-tooltip-value">@day.KgSaved.ToString("0.#") kg saved</span>
                            </span>
                            <div class="dash-trend-bar dash-trend-bar-kg" style="height: @(BarHeightPx(day.KgSaved, _maxKgSaved))px"></div>
                        </div>
                    }
                </div>
            </div>
            <div class="dash-trend-row dash-trend-axis-row">
                <span class="dash-trend-label"></span>
                <div class="dash-trend-chart">
                    @for (var i = 0; i < _dailyStats.Count; i++)
                    {
                        var isToday = i == _dailyStats.Count - 1;
                        <div class="dash-trend-axis-tick">
                            @if (isToday)
                            {
                                <span class="dash-trend-axis-today">Today</span>
                            }
                            else if (i % 2 == 0)
                            {
                                <span>@_dailyStats[i].Date.ToString("MMM d")</span>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0">
        <h6 class="fw-semibold mb-0">Business Analytics</h6>
        <p class="text-muted small mb-0">Packages with a pickup window in the last 14 days.</p>
    </div>
    <div class="card-body px-4 pb-4">
        @if (_ordersUnavailable)
        {
            <p class="text-muted small mb-0">You don't manage a business yet, so there's no analytics to show.</p>
        }
        else if (_analyticsPackages is null)
        {
            <div class="d-flex justify-content-center py-4">
                <div class="spinner-border spinner-border-sm text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        }
        else
        {
            <div class="row g-4">
                <div class="col-md-5">
                    <div class="text-muted small mb-1">Sell-through rate</div>
                    @if (_soldQty + _unsoldQty == 0)
                    {
                        <p class="text-muted small mb-0">No packages with a closed pickup window yet in this period.</p>
                    }
                    else
                    {
                        <div class="d-flex align-items-baseline gap-2 mb-2">
                            <span class="fw-bold fs-2">@_sellThroughRate.ToString("P0")</span>
                            <span class="text-muted small">@_soldQty of @(_soldQty + _unsoldQty) listed picked up</span>
                        </div>
                        <div class="progress" style="height: 8px;">
                            <div class="progress-bar bg-success" role="progressbar"
                                 style="width: @(SellThroughRatePercent)%"
                                 aria-valuenow="@(SellThroughRatePercent)" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                        <div class="text-muted small mt-2">@_closedPackageCount package@(_closedPackageCount == 1 ? "" : "s") with a closed pickup window.</div>
                    }
                </div>
                <div class="col-md-7">
                    <div class="text-muted small mb-2">Busiest pickup hours <span class="text-muted">(completed pickups)</span></div>
                    <div class="dash-trend-chart" style="height: 56px;">
                        @for (var h = 0; h < 24; h++)
                        {
                            var hour = h;
                            var qty = _hourlyPickupQty[hour];
                            <div class="dash-trend-bar-wrap" tabindex="0"
                                 aria-label="@HourLabel(hour): @qty pickup@(qty == 1 ? "" : "s")">
                                <span class="dash-trend-tooltip">
                                    <span class="dash-trend-tooltip-date">@HourLabel(hour)</span>
                                    <span class="dash-trend-tooltip-value">@qty pickup@(qty == 1 ? "" : "s")</span>
                                </span>
                                <div class="dash-trend-bar dash-trend-bar-hours" style="height: @(BarHeightPx(qty, _maxHourlyQty))px"></div>
                            </div>
                        }
                    </div>
                    <div class="dash-trend-chart dash-trend-axis-row">
                        @for (var h = 0; h < 24; h++)
                        {
                            <div class="dash-trend-axis-tick">@(h % 3 == 0 ? $"{h}h" : "")</div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0">
        <h6 class="fw-semibold mb-0">Quick Actions</h6>
    </div>
    <div class="card-body px-4 pb-4">
        <div class="row g-2">
            <div class="col-sm-6 col-lg-3">
                <a href="/businesses" class="btn btn-outline-secondary w-100 d-flex align-items-center gap-2">
                    <i class="bi bi-building"></i> All Businesses
                </a>
            </div>
            <AuthorizeView Roles="@AppRoles.Admin" Context="adminContext">
                <Authorized>
                    <div class="col-sm-6 col-lg-3">
                        <a href="/businesses/create" class="btn btn-outline-primary w-100 d-flex align-items-center gap-2">
                            <i class="bi bi-plus-lg"></i> Add Business
                        </a>
                    </div>
                </Authorized>
            </AuthorizeView>
            <div class="col-sm-6 col-lg-3">
                <a href="/packages" class="btn btn-outline-secondary w-100 d-flex align-items-center gap-2">
                    <i class="bi bi-box-seam"></i> All Packages
                </a>
            </div>
            <AuthorizeView Roles="@($"{AppRoles.Admin},{AppRoles.BusinessManager}")" Context="managerContext">
                <Authorized>
                    <div class="col-sm-6 col-lg-3">
                        <a href="/packages/create" class="btn btn-outline-primary w-100 d-flex align-items-center gap-2">
                            <i class="bi bi-plus-lg"></i> Add Package
                        </a>
                    </div>
                    <div class="col-sm-6 col-lg-3">
                        <a href="/orders/manage" class="btn btn-outline-secondary w-100 d-flex align-items-center gap-2">
                            <i class="bi bi-cart3"></i> Manage Orders
                        </a>
                    </div>
                </Authorized>
            </AuthorizeView>
        </div>
    </div>
</div>

@code {
    private bool _isAdmin;
    private int? _businessCount;
    private int? _packageCount;
    private int? _orderCount;
    private int? _userCount;
    private bool _ordersUnavailable;

    private record DailyStat(DateOnly Date, int OrderCount, decimal KgSaved);
    private List<DailyStat>? _dailyStats;
    private int _maxOrderCount = 1;
    private decimal _maxKgSaved = 1m;

    // Business analytics (sell-through rate, busiest pickup hours) — both derived from one fetch.
    private List<Package>? _analyticsPackages;
    private int _closedPackageCount;
    private int _soldQty;
    private int _unsoldQty;
    private decimal _sellThroughRate;
    private int[] _hourlyPickupQty = new int[24];
    private int _maxHourlyQty = 1;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _isAdmin = authState.User.IsInRole(AppRoles.Admin);

        if (!_isAdmin)
        {
            await ManagedBusinessContext.EnsureLoadedAsync();
            ManagedBusinessContext.OnChange += HandleManagedBusinessChanged;
        }

        await LoadDashboardAsync();

        ClientTimeZoneService.OnChange += HandleTimeZoneChanged;
    }

    private async Task LoadDashboardAsync()
    {
        var allPackages = (await PackageController.GetAllAsync()).Value ?? [];

        Guid? myBusinessId = null;

        // Business managers only see counts scoped to their currently selected business, not
        // platform-wide totals.
        if (_isAdmin)
        {
            _businessCount = (await BusinessController.GetAllAsync()).Value?.Count;
            _packageCount = allPackages.Count;
            _userCount = await UserManager.Users.CountAsync();
        }
        else
        {
            myBusinessId = ManagedBusinessContext.SelectedBusinessId;
            _packageCount = myBusinessId is null ? 0 : allPackages.Count(p => p.BusinessId == myBusinessId);
        }

        var orders = await OrderController.GetOrdersForManagementAsync(myBusinessId);
        if (orders.Result is UnauthorizedResult)
        {
            _ordersUnavailable = true;
            return;
        }

        _ordersUnavailable = false;
        _orderCount = orders.Value?.Count ?? 0;
        await LoadDailyStatsAsync(myBusinessId);
        await LoadAnalyticsAsync(myBusinessId);
    }

    private void HandleManagedBusinessChanged() => InvokeAsync(async () =>
    {
        await LoadDashboardAsync();
        StateHasChanged();
    });

    private void HandleTimeZoneChanged()
    {
        RecomputeHourlyPickupStats();
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ManagedBusinessContext.OnChange -= HandleManagedBusinessChanged;
        ClientTimeZoneService.OnChange -= HandleTimeZoneChanged;
    }

    private async Task LoadDailyStatsAsync(Guid? businessId)
    {
        // Bucketed in UTC, not local time — good enough for a trend shape, no JS interop needed.
        var since = DateTime.UtcNow.Date.AddDays(-13);
        var rangeOrders = (await OrderController.GetOrdersInRangeAsync(since, null, businessId)).Value ?? [];

        _dailyStats = Enumerable.Range(0, 14)
            .Select(i => since.AddDays(i))
            .Select(day =>
            {
                var ordersThatDay = rangeOrders.Where(o => o.CreatedAt.Date == day).ToList();
                var kgSaved = ordersThatDay
                    .Where(o => o.Status.Name == OrderStatuses.Completed)
                    .Sum(o => o.OrderPackages.Sum(op => op.Quantity * op.Package.WeightKg));

                return new DailyStat(DateOnly.FromDateTime(day), ordersThatDay.Count, kgSaved);
            })
            .ToList();

        _maxOrderCount = Math.Max(1, _dailyStats.Max(d => d.OrderCount));
        _maxKgSaved = Math.Max(1m, _dailyStats.Max(d => d.KgSaved));
    }

    private async Task LoadAnalyticsAsync(Guid? businessId)
    {
        var since = DateTime.UtcNow.Date.AddDays(-13);
        var result = await PackageController.GetForAnalyticsAsync(businessId, since);
        if (result.Result is UnauthorizedResult)
        {
            _analyticsPackages = [];
            return;
        }

        _analyticsPackages = result.Value ?? [];

        // Only counts closed pickup windows — an open package's remaining stock isn't "unsold"
        // yet, it just hasn't finished selling (Confirmed already decremented it like a sale).
        var now = DateTime.UtcNow;
        var closed = _analyticsPackages.Where(p => p.PickupEnd < now).ToList();
        _closedPackageCount = closed.Count;
        _soldQty = closed.Sum(p => p.OrderPackages.Where(op => op.Order.Status.Name == OrderStatuses.Completed).Sum(op => op.Quantity));
        _unsoldQty = closed.Sum(p => p.Quantity);
        var totalOffered = _soldQty + _unsoldQty;
        _sellThroughRate = totalOffered > 0 ? (decimal)_soldQty / totalOffered : 0m;

        RecomputeHourlyPickupStats();
    }

    // Split out so a late-resolving timezone (HandleTimeZoneChanged) can rebucket by local hour
    // without a refetch.
    private void RecomputeHourlyPickupStats()
    {
        var hourly = new int[24];
        foreach (var package in _analyticsPackages ?? [])
        {
            var completedQty = package.OrderPackages
                .Where(op => op.Order.Status.Name == OrderStatuses.Completed)
                .Sum(op => op.Quantity);
            if (completedQty <= 0)
                continue;

            var localHour = ClientTimeZoneService.ToLocal(package.PickupStart).Hour;
            hourly[localHour] += completedQty;
        }

        _hourlyPickupQty = hourly;
        _maxHourlyQty = Math.Max(1, hourly.Max());
    }

    private static string HourLabel(int hour) => $"{hour:00}:00–{(hour + 1) % 24:00}:00";

    // An int, not a decimal — avoids "70,0%" landing in inline CSS and silently breaking the width in ro-RO locale.
    private int SellThroughRatePercent => (int)Math.Round(_sellThroughRate * 100);

    // Pixels, not percentage height — percentages don't reliably resolve through an unstretched flex-item chain.
    private const int ChartHeightPx = 64;

    private static int BarHeightPx(decimal value, decimal max)
    {
        if (value <= 0)
            return 3;

        return (int)Math.Clamp(value / max * ChartHeightPx, 4, ChartHeightPx);
    }
}