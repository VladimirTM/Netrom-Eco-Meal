@page "/packages/create"
@page "/packages/edit/{Id:guid}"
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Mvc
@using Netrom_Eco_Meal.Constants
@using Netrom_Eco_Meal.Controllers
@using Netrom_Eco_Meal.Entities
@using Netrom_Eco_Meal.Services
@using Netrom_Eco_Meal.Services.Interfaces
@rendermode InteractiveServer
@implements IDisposable
@inject PackageController PackageController
@inject PackageTemplateController PackageTemplateController
@inject IPackageTypeService PackageTypeService
@inject IBusinessService BusinessService
@inject IImageUploadService ImageUploadService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@inject ClientTimeZoneService ClientTimeZoneService
@inject ManagedBusinessContext ManagedBusinessContext
@attribute [Authorize(Roles = $"{AppRoles.Admin},{AppRoles.BusinessManager}")]

<PageTitle>@(IsEdit ? "Edit Package" : "Create Package") — Eco Meal</PageTitle>

@if (_forbidden)
{
    <ForbiddenPanel Message="@_forbiddenReason" BackHref="/packages" BackLabel="Back to packages"/>
    return;
}

@if (_notFound)
{
    <NotFoundPanel Title="Package not found" Message="This package no longer exists — it may have already been deleted."
                   BackHref="/packages" BackLabel="Back to packages"/>
    return;
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1">@(IsEdit ? "Edit Package" : "Create Package")</h1>
        <p class="text-muted small mb-0">@(IsEdit ? "Update the package details" : "Add a new food package to the platform")</p>
    </div>
    <a href="/packages" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Back
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7 col-xl-6">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <EditForm Model="@_model" OnValidSubmit="Submit" FormName="packageForm">
                    <DataAnnotationsValidator/>
                    <div class="mb-3">
                        <label for="name" class="form-label fw-semibold">Name</label>
                        <InputText id="name" class="form-control" placeholder="e.g. Morning Pastry Box" @bind-Value="_model.Name"/>
                        <ValidationMessage For="@(() => _model.Name)" class="validation-message small d-block mt-1"/>
                    </div>
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <label for="description" class="form-label fw-semibold mb-0">Description</label>
                            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(_draftingDescription || string.IsNullOrWhiteSpace(_model.Name))" @onclick="DraftDescriptionAsync">
                                @if (_draftingDescription)
                                {
                                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                }
                                else
                                {
                                    <i class="bi bi-magic me-1"></i>
                                }
                                Write it for me
                            </button>
                        </div>
                        <InputText id="description" class="form-control mt-1" placeholder="Short description of the package" @bind-Value="_model.Description"/>
                        <ValidationMessage For="@(() => _model.Description)" class="validation-message small d-block mt-1"/>
                        @if (_aiDraftError is not null)
                        {
                            <div class="text-danger small mt-1">@_aiDraftError</div>
                        }
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label for="business" class="form-label fw-semibold">Business</label>
                            <InputSelect id="business" class="form-select" @bind-Value="_model.BusinessId" disabled="@(!_isAdmin)">
                                @foreach (var business in _businesses)
                                {
                                    <option value="@business.Id">@business.Name</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-sm-6">
                            <label for="packageType" class="form-label fw-semibold">Type</label>
                            <InputSelect id="packageType" class="form-select" @bind-Value="_model.PackageTypeId">
                                @foreach (var type in _packageTypes)
                                {
                                    <option value="@type.Id">@type.Name</option>
                                }
                            </InputSelect>
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label for="price" class="form-label fw-semibold">Price</label>
                            <div class="input-group">
                                <span class="input-group-text">RON</span>
                                <InputNumber id="price" class="form-control" placeholder="0.00" @bind-Value="_model.Price"/>
                            </div>
                            <ValidationMessage For="@(() => _model.Price)" class="validation-message small d-block mt-1"/>
                        </div>
                        <div class="col-sm-6">
                            <label for="quantity" class="form-label fw-semibold">Quantity</label>
                            <InputNumber id="quantity" class="form-control" placeholder="1" @bind-Value="_model.Quantity"/>
                            <ValidationMessage For="@(() => _model.Quantity)" class="validation-message small d-block mt-1"/>
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label for="weightKg" class="form-label fw-semibold">Weight (kg)</label>
                            <InputNumber id="weightKg" class="form-control" placeholder="1.0" @bind-Value="_model.WeightKg"/>
                            <ValidationMessage For="@(() => _model.WeightKg)" class="validation-message small d-block mt-1"/>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Dietary & allergen tags <span class="text-muted fw-normal">(optional)</span>
                        </label>
                        <div class="pkg-form-tag-grid">
                            @foreach (var tag in Netrom_Eco_Meal.Constants.DietaryTags.All)
                            {
                                <label class="pkg-form-tag-check">
                                    <input type="checkbox" checked="@_model.DietaryTags.Contains(tag)"
                                           @onchange="e => ToggleTag(tag, (bool)e.Value!)"/>
                                    @tag
                                </label>
                            }
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label for="pickupStart" class="form-label fw-semibold">Pickup Start</label>
                            <InputDate id="pickupStart" class="form-control" Type="InputDateType.DateTimeLocal" @bind-Value="_model.PickupStart"/>
                        </div>
                        <div class="col-sm-6">
                            <label for="pickupEnd" class="form-label fw-semibold">Pickup End</label>
                            <InputDate id="pickupEnd" class="form-control" Type="InputDateType.DateTimeLocal" @bind-Value="_model.PickupEnd"/>
                        </div>
                        <ValidationMessage For="@(() => _model.PickupEnd)" class="validation-message small d-block mt-1"/>
                    </div>
                    <div class="mb-4">
                        <label for="imageFile" class="form-label fw-semibold">
                            Photo <span class="text-muted fw-normal">(optional)</span>
                        </label>
                        <div class="d-flex align-items-start gap-3">
                            @if (!string.IsNullOrWhiteSpace(_model.ImageUrl))
                            {
                                <img src="@_model.ImageUrl" alt="Package photo preview" class="form-image-preview"/>
                            }
                            <div class="flex-grow-1">
                                <InputFile id="imageFile" class="form-control" accept="image/*" OnChange="OnImageSelectedAsync" disabled="@_uploadingImage"/>
                                <div class="form-text">Or paste an image URL directly:</div>
                                <InputText class="form-control form-control-sm mt-1" placeholder="https://..." @bind-Value="_model.ImageUrl"/>
                                @if (_uploadingImage)
                                {
                                    <div class="text-muted small mt-1"><span class="spinner-border spinner-border-sm me-1" role="status"></span>Uploading…</div>
                                }
                                @if (_imageUploadError is not null)
                                {
                                    <div class="text-danger small mt-1">@_imageUploadError</div>
                                }
                            </div>
                        </div>
                    </div>
                    @if (!IsEdit)
                    {
                        <div class="mb-4 form-check">
                            <input type="checkbox" class="form-check-input" id="repeatDaily" @bind="_model.RepeatDaily"/>
                            <label class="form-check-label" for="repeatDaily">
                                <i class="bi bi-arrow-repeat me-1"></i>Repeat this every day
                            </label>
                            <div class="form-text">
                                A fresh package with this same name, price, and pickup window (@_model.PickupStart.ToString("HH:mm")–@_model.PickupEnd.ToString("HH:mm")) is created automatically each day.
                            </div>
                        </div>
                    }
                    <button type="submit" class="btn btn-primary w-100 py-2">
                        <i class="bi bi-check-lg me-1"></i> @(IsEdit ? "Save Changes" : "Create Package")
                    </button>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public Guid? Id { get; set; }

    private bool IsEdit => Id.HasValue;

    private PackageFormModel _model = new();
    private List<PackageType> _packageTypes = [];
    private List<Business> _businesses = [];
    private bool _isAdmin;
    private bool _forbidden;
    private string _forbiddenReason = "";
    private bool _notFound;
    private bool _uploadingImage;
    private string? _imageUploadError;
    private bool _draftingDescription;
    private string? _aiDraftError;

    // Raw UTC, so the pickup fields can be re-derived if the timezone resolves late.
    private DateTime? _existingPickupStartUtc;
    private DateTime? _existingPickupEndUtc;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _isAdmin = authState.User.IsInRole(AppRoles.Admin);
        var currentUserId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (!_isAdmin)
            await ManagedBusinessContext.EnsureLoadedAsync();

        if (!_isAdmin && ManagedBusinessContext.MyBusinesses.Count == 0)
        {
            _forbidden = true;
            _forbiddenReason = "You don't manage a business yet, so you can't add or edit packages.";
            return;
        }

        _packageTypes = await PackageTypeService.GetAllAsync();
        _businesses = _isAdmin ? await BusinessService.GetAllAsync() : ManagedBusinessContext.MyBusinesses;

        if (IsEdit)
        {
            var existing = (await PackageController.GetByIdAsync(Id!.Value)).Value;
            if (existing is null)
            {
                _notFound = true;
                return;
            }

            // Checked against every business this staffer belongs to (not just the one currently
            // selected in the switcher) so they can still edit a package elsewhere they're staff.
            if (!_isAdmin && (currentUserId is null || !await BusinessService.IsStaffAsync(existing.BusinessId, currentUserId)))
            {
                _forbidden = true;
                _forbiddenReason = "You can only edit packages that belong to your business.";
                return;
            }

            _existingPickupStartUtc = existing.PickupStart;
            _existingPickupEndUtc = existing.PickupEnd;

            _model.Name = existing.Name;
            _model.Description = existing.Description;
            _model.Price = existing.Price;
            _model.Quantity = existing.Quantity;
            _model.WeightKg = existing.WeightKg;
            _model.DietaryTags = [..existing.DietaryTags];
            _model.PickupStart = ClientTimeZoneService.ToLocal(existing.PickupStart);
            _model.PickupEnd = ClientTimeZoneService.ToLocal(existing.PickupEnd);
            _model.ImageUrl = existing.ImageUrl;
            _model.BusinessId = existing.BusinessId;
            _model.PackageTypeId = existing.PackageTypeId;
            _model.NowLocal = ClientTimeZoneService.ToLocal(DateTime.UtcNow);
        }
        else
        {
            // InputSelect only syncs its bound value once the user changes the selection, so without
            // these defaults the IDs stay Guid.Empty and the insert fails its FK constraints.
            if (_packageTypes.Count > 0)
                _model.PackageTypeId = _packageTypes[0].Id;
            if (_businesses.Count > 0)
                _model.BusinessId = !_isAdmin && ManagedBusinessContext.SelectedBusinessId is { } selectedId
                    ? selectedId
                    : _businesses[0].Id;

            var localNow = ClientTimeZoneService.ToLocal(DateTime.UtcNow);
            _model.PickupStart = localNow;
            _model.PickupEnd = localNow.AddHours(2);
            _model.NowLocal = localNow;
        }

        // Re-derives the fields above if the timezone resolves after they were first set.
        ClientTimeZoneService.OnChange += HandleTimeZoneChanged;
    }

    private void HandleTimeZoneChanged()
    {
        if (IsEdit)
        {
            if (_existingPickupStartUtc.HasValue)
                _model.PickupStart = ClientTimeZoneService.ToLocal(_existingPickupStartUtc.Value);
            if (_existingPickupEndUtc.HasValue)
                _model.PickupEnd = ClientTimeZoneService.ToLocal(_existingPickupEndUtc.Value);
            _model.NowLocal = ClientTimeZoneService.ToLocal(DateTime.UtcNow);
        }
        else
        {
            var localNow = ClientTimeZoneService.ToLocal(DateTime.UtcNow);
            _model.PickupStart = localNow;
            _model.PickupEnd = localNow.AddHours(2);
            _model.NowLocal = localNow;
        }

        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ClientTimeZoneService.OnChange -= HandleTimeZoneChanged;
    }

    private void ToggleTag(string tag, bool isSelected)
    {
        if (isSelected)
        {
            if (!_model.DietaryTags.Contains(tag))
                _model.DietaryTags.Add(tag);
        }
        else
        {
            _model.DietaryTags.Remove(tag);
        }
    }

    private async Task OnImageSelectedAsync(InputFileChangeEventArgs e)
    {
        _imageUploadError = null;

        if (e.File.Size > ImageUpload.MaxSizeBytes)
        {
            _imageUploadError = $"Image is too large — max {ImageUpload.MaxSizeBytes / 1024 / 1024} MB.";
            return;
        }

        _uploadingImage = true;
        try
        {
            await using var stream = e.File.OpenReadStream(ImageUpload.MaxSizeBytes);
            _model.ImageUrl = await ImageUploadService.SaveAsync(stream, e.File.Name, "packages");
        }
        catch (InvalidOperationException ex)
        {
            _imageUploadError = ex.Message;
        }
        catch (IOException)
        {
            _imageUploadError = $"Image is too large — max {ImageUpload.MaxSizeBytes / 1024 / 1024} MB.";
        }
        finally
        {
            _uploadingImage = false;
        }
    }

    private async Task DraftDescriptionAsync()
    {
        _aiDraftError = null;
        _draftingDescription = true;
        try
        {
            var packageTypeName = _packageTypes.FirstOrDefault(t => t.Id == _model.PackageTypeId)?.Name ?? "";
            var result = await PackageController.DraftDescriptionAsync(_model.Name!, packageTypeName, _model.DietaryTags);
            if (result.Result is ConflictObjectResult conflict)
                _aiDraftError = conflict.Value?.ToString() ?? "The AI assistant isn't available right now.";
            else if (result.Value is not null)
                _model.Description = result.Value;
        }
        finally
        {
            _draftingDescription = false;
        }
    }

    private async Task Submit()
    {
        // The form works entirely in the viewer's local time — convert back to UTC for storage.
        var pickupStart = ClientTimeZoneService.ToUtc(_model.PickupStart);
        var pickupEnd = ClientTimeZoneService.ToUtc(_model.PickupEnd);

        if (IsEdit)
        {
            var package = new Package
            {
                Id = Id!.Value,
                Name = _model.Name!,
                Description = _model.Description!,
                Price = _model.Price,
                Quantity = _model.Quantity,
                WeightKg = _model.WeightKg,
                DietaryTags = _model.DietaryTags,
                PickupStart = pickupStart,
                PickupEnd = pickupEnd,
                ImageUrl = _model.ImageUrl,
                BusinessId = _model.BusinessId,
                PackageTypeId = _model.PackageTypeId
            };
            await PackageController.UpdateAsync(package);
        }
        else
        {
            var package = new Package
            {
                Name = _model.Name!,
                Description = _model.Description!,
                Price = _model.Price,
                Quantity = _model.Quantity,
                WeightKg = _model.WeightKg,
                DietaryTags = _model.DietaryTags,
                PickupStart = pickupStart,
                PickupEnd = pickupEnd,
                ImageUrl = _model.ImageUrl,
                BusinessId = _model.BusinessId,
                PackageTypeId = _model.PackageTypeId
            };
            await PackageController.AddAsync(package);

            if (_model.RepeatDaily)
                await PackageTemplateController.CreateFromPackageAsync(package.Id, pickupStart.TimeOfDay, pickupEnd.TimeOfDay);
        }

        NavigationManager.NavigateTo("/packages");
    }

    private class PackageFormModel : IValidatableObject
    {
        [Required(ErrorMessage = "Enter a package name.")]
        public string? Name { get; set; }

        [Required(ErrorMessage = "Enter a short description.")]
        public string? Description { get; set; }

        [Range(0.01, 10000, ErrorMessage = "Price must be between 0.01 and 10,000.")]
        public decimal Price { get; set; }

        [Range(1, 1000, ErrorMessage = "Quantity must be between 1 and 1,000.")]
        public int Quantity { get; set; } = 1;

        [Range(0.01, 100, ErrorMessage = "Weight must be between 0.01 and 100.")]
        public decimal WeightKg { get; set; } = 1;

        public List<string> DietaryTags { get; set; } = [];

        public DateTime PickupStart { get; set; } = DateTime.Now;
        public DateTime PickupEnd { get; set; } = DateTime.Now.AddHours(2);
        public string? ImageUrl { get; set; }
        public Guid BusinessId { get; set; }
        public Guid PackageTypeId { get; set; }
        public bool RepeatDaily { get; set; }

        // Kept in sync with the viewer's local time by the parent component — comparing PickupEnd
        // against DateTime.Now here would use the server's timezone instead of the viewer's.
        public DateTime NowLocal { get; set; } = DateTime.Now;

        // Cross-field rules — can't be expressed with a single [Range]/[Required] attribute.
        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (PickupEnd <= PickupStart)
                yield return new ValidationResult("Pickup end must be after pickup start.", [nameof(PickupEnd)]);

            // Only PickupEnd is checked so editing a package that's already mid-window (PickupStart
            // in the past, PickupEnd still ahead) doesn't get blocked.
            if (PickupEnd <= NowLocal)
                yield return new ValidationResult("Pickup end must be in the future.", [nameof(PickupEnd)]);
        }
    }
}