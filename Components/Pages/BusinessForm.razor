@page "/businesses/create"
@page "/businesses/edit/{Id:guid}"
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Mvc
@using Netrom_Eco_Meal.Constants
@using Netrom_Eco_Meal.Controllers
@using Netrom_Eco_Meal.Entities
@using Netrom_Eco_Meal.Services.Interfaces
@rendermode InteractiveServer
@inject BusinessController BusinessController
@inject IBusinessService BusinessService
@inject IBusinessTypeService BusinessTypeService
@inject IImageUploadService ImageUploadService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@attribute [Authorize(Roles = $"{AppRoles.Admin},{AppRoles.BusinessManager}")]

<PageTitle>@(IsEdit ? "Edit Business" : "Create Business") — Eco Meal</PageTitle>

@if (_forbidden)
{
    <ForbiddenPanel Message="@(IsEdit ? "You can only edit your own business." : "Only an admin can create new businesses.")"
                    BackHref="/businesses" BackLabel="Back to businesses"/>
    return;
}

@if (_notFound)
{
    <NotFoundPanel Title="Business not found" Message="This business no longer exists — it may have already been deleted."
                   BackHref="/businesses" BackLabel="Back to businesses"/>
    return;
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1">@(IsEdit ? "Edit Business" : "Create Business")</h1>
        <p class="text-muted small mb-0">@(IsEdit ? "Update the business details" : "Add a new food business to the platform")</p>
    </div>
    <a href="/businesses" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Back
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7 col-xl-6">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <EditForm Model="@_model" OnValidSubmit="Submit" FormName="businessForm">
                    <DataAnnotationsValidator/>
                    <div class="mb-3">
                        <label for="name" class="form-label fw-semibold">Name</label>
                        <InputText id="name" class="form-control" placeholder="e.g. Green Bites" @bind-Value="_model.Name"/>
                        <ValidationMessage For="@(() => _model.Name)" class="validation-message small d-block mt-1"/>
                    </div>
                    <div class="mb-3">
                        <label for="description" class="form-label fw-semibold">Description</label>
                        <InputText id="description" class="form-control" placeholder="Short description of the business" @bind-Value="_model.Description"/>
                        <ValidationMessage For="@(() => _model.Description)" class="validation-message small d-block mt-1"/>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-sm-7">
                            <label for="address" class="form-label fw-semibold">Address</label>
                            <InputText id="address" class="form-control" placeholder="Street, City" @bind-Value="_model.Address"/>
                            <ValidationMessage For="@(() => _model.Address)" class="validation-message small d-block mt-1"/>
                        </div>
                        <div class="col-sm-5">
                            <label for="businessType" class="form-label fw-semibold">Type</label>
                            <InputSelect id="businessType" class="form-select" @bind-Value="_model.BusinessTypeId">
                                @foreach (var type in _businessTypes)
                                {
                                    <option value="@type.Id">@type.Name</option>
                                }
                            </InputSelect>
                        </div>
                    </div>
                    <div class="mb-4">
                        <label for="imageFile" class="form-label fw-semibold">
                            Photo <span class="text-muted fw-normal">(optional)</span>
                        </label>
                        <div class="d-flex align-items-start gap-3">
                            @if (!string.IsNullOrWhiteSpace(_model.ImageUrl))
                            {
                                <img src="@_model.ImageUrl" alt="Business photo preview" class="form-image-preview"/>
                            }
                            <div class="flex-grow-1">
                                <InputFile id="imageFile" class="form-control" accept="image/*" OnChange="OnImageSelectedAsync" disabled="@_uploadingImage"/>
                                <div class="form-text">Or paste an image URL directly:</div>
                                <InputText class="form-control form-control-sm mt-1" placeholder="https://..." @bind-Value="_model.ImageUrl"/>
                                @if (_uploadingImage)
                                {
                                    <div class="text-muted small mt-1"><span class="spinner-border spinner-border-sm me-1" role="status"></span>Uploading…</div>
                                }
                                @if (_imageUploadError is not null)
                                {
                                    <div class="text-danger small mt-1">@_imageUploadError</div>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-semibold">
                            Location <span class="text-muted fw-normal">(optional — powers "near me" sort and the map view)</span>
                        </label>
                        <div class="row g-3">
                            <div class="col-sm-5">
                                <InputNumber class="form-control" placeholder="Latitude" @bind-Value="_model.Latitude"/>
                                <ValidationMessage For="@(() => _model.Latitude)" class="validation-message small d-block mt-1"/>
                            </div>
                            <div class="col-sm-5">
                                <InputNumber class="form-control" placeholder="Longitude" @bind-Value="_model.Longitude"/>
                                <ValidationMessage For="@(() => _model.Longitude)" class="validation-message small d-block mt-1"/>
                            </div>
                            <div class="col-sm-2">
                                <button type="button" class="btn btn-outline-secondary w-100" @onclick="UseCurrentLocationAsync" disabled="@_locating">
                                    @if (_locating)
                                    {
                                        <span class="spinner-border spinner-border-sm" role="status"></span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-geo-alt"></i>
                                    }
                                </button>
                            </div>
                        </div>
                        @if (_locationError is not null)
                        {
                            <div class="text-danger small mt-1">@_locationError</div>
                        }
                    </div>
                    <button type="submit" class="btn btn-primary w-100 py-2">
                        <i class="bi bi-check-lg me-1"></i> @(IsEdit ? "Save Changes" : "Create Business")
                    </button>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@if (IsEdit && !_forbidden && !_notFound)
{
    <div class="row justify-content-center mt-4">
        <div class="col-lg-7 col-xl-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h2 class="h5 fw-bold mb-1">Opening Hours</h2>
                    <p class="text-muted small mb-3">Powers the "closed now" indicator customers see on your kitchen's card and page.</p>

                    @if (_hoursError is not null)
                    {
                        <div class="alert alert-danger py-2 small">@_hoursError</div>
                    }
                    @if (_hoursSavedMessage is not null)
                    {
                        <div class="alert alert-success py-2 small">@_hoursSavedMessage</div>
                    }

                    @foreach (var row in _hoursRows)
                    {
                        <div class="row g-2 align-items-center mb-2" @key="row.DayOfWeek">
                            <div class="col-3 small fw-semibold">@row.DayOfWeek.ToString()[..3]</div>
                            <div class="col-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="@($"closed-{row.DayOfWeek}")" @bind="row.IsClosed"/>
                                    <label class="form-check-label small" for="@($"closed-{row.DayOfWeek}")">Closed</label>
                                </div>
                            </div>
                            <div class="col-3">
                                <input type="time" class="form-control form-control-sm" @bind="row.OpenTime" disabled="@row.IsClosed"/>
                            </div>
                            <div class="col-3">
                                <input type="time" class="form-control form-control-sm" @bind="row.CloseTime" disabled="@row.IsClosed"/>
                            </div>
                        </div>
                    }

                    <button type="button" class="btn btn-outline-primary btn-sm mt-2" disabled="@_savingHours" @onclick="SaveHoursAsync">
                        @if (_savingHours)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        }
                        Save hours
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="row justify-content-center mt-4">
        <div class="col-lg-7 col-xl-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h2 class="h5 fw-bold mb-1">Holiday Closures</h2>
                    <p class="text-muted small mb-3">Overrides your weekly hours for a date range — e.g. a vacation or a one-off closure.</p>

                    @if (_closureError is not null)
                    {
                        <div class="alert alert-danger py-2 small">@_closureError</div>
                    }

                    @if (_closures.Count > 0)
                    {
                        <ul class="list-group list-group-flush mb-3">
                            @foreach (var closure in _closures)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center px-0" @key="closure.Id">
                                    <div>
                                        <div class="small fw-semibold">@closure.StartDate.ToString("MMM d, yyyy") – @closure.EndDate.ToString("MMM d, yyyy")</div>
                                        @if (!string.IsNullOrWhiteSpace(closure.Reason))
                                        {
                                            <div class="text-muted small">@closure.Reason</div>
                                        }
                                    </div>
                                    <button type="button" class="btn btn-sm btn-outline-danger" title="Remove closure" @onclick="() => _pendingRemoveClosure = closure">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted small">No holiday closures scheduled.</p>
                    }

                    <div class="row g-2">
                        <div class="col-sm-4">
                            <label class="form-label small">Start date</label>
                            <input type="date" class="form-control form-control-sm" @bind="_closureStart"/>
                        </div>
                        <div class="col-sm-4">
                            <label class="form-label small">End date</label>
                            <input type="date" class="form-control form-control-sm" @bind="_closureEnd"/>
                        </div>
                        <div class="col-sm-4">
                            <label class="form-label small">Reason <span class="text-muted fw-normal">(optional)</span></label>
                            <input type="text" class="form-control form-control-sm" placeholder="e.g. Summer vacation" @bind="_closureReason"/>
                        </div>
                    </div>
                    <button type="button" class="btn btn-outline-primary btn-sm mt-3" disabled="@_addingClosure" @onclick="AddClosureAsync">
                        @if (_addingClosure)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        }
                        Add closure
                    </button>
                </div>
            </div>
        </div>
    </div>

    <ConfirmDialog IsOpen="@(_pendingRemoveClosure is not null)"
                   Title="Remove closure?"
                   Message="@(_pendingRemoveClosure is null ? "" : $"The closure from {_pendingRemoveClosure.StartDate:MMM d, yyyy} to {_pendingRemoveClosure.EndDate:MMM d, yyyy} will be removed. This can't be undone.")"
                   ConfirmLabel="Remove closure"
                   Busy="@_removingClosure"
                   OnConfirm="ConfirmRemoveClosureAsync"
                   OnCancel="() => _pendingRemoveClosure = null"/>
}

@code {
    [Parameter] public Guid? Id { get; set; }

    private bool IsEdit => Id.HasValue;

    private BusinessFormModel _model = new();
    private List<BusinessType> _businessTypes = [];
    private bool _forbidden;
    private bool _notFound;
    private bool _locating;
    private string? _locationError;
    private bool _uploadingImage;
    private string? _imageUploadError;

    private static readonly DayOfWeek[] WeekOrder =
        [DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday, DayOfWeek.Saturday, DayOfWeek.Sunday];

    private List<BusinessHours> _hoursRows = [];
    private bool _savingHours;
    private string? _hoursError;
    private string? _hoursSavedMessage;

    private List<BusinessClosure> _closures = [];
    private DateOnly? _closureStart;
    private DateOnly? _closureEnd;
    private string? _closureReason;
    private bool _addingClosure;
    private string? _closureError;
    private BusinessClosure? _pendingRemoveClosure;
    private bool _removingClosure;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var isAdmin = authState.User.IsInRole(AppRoles.Admin);
        var currentUserId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (!IsEdit)
        {
            if (!isAdmin)
            {
                _forbidden = true;
                return;
            }
        }

        _businessTypes = await BusinessTypeService.GetAllAsync();

        if (IsEdit)
        {
            var existing = (await BusinessController.GetByIdAsync(Id!.Value)).Value;
            if (existing is null)
            {
                _notFound = true;
                return;
            }

            if (!isAdmin && (currentUserId is null || !await BusinessService.IsStaffAsync(existing.Id, currentUserId)))
            {
                _forbidden = true;
                return;
            }

            _model.Name = existing.Name;
            _model.Description = existing.Description;
            _model.Address = existing.Address;
            _model.ImageUrl = existing.ImageUrl;
            _model.Latitude = existing.Latitude;
            _model.Longitude = existing.Longitude;
            _model.BusinessTypeId = existing.BusinessTypeId;

            _hoursRows = BuildWeekRows(existing.Hours);
            _closures = existing.Closures.OrderBy(c => c.StartDate).ToList();
        }
        else if (_businessTypes.Count > 0)
        {
            // InputSelect only syncs its bound value once the user changes the selection, so without
            // this default BusinessTypeId stays Guid.Empty and the insert fails its FK constraint.
            _model.BusinessTypeId = _businessTypes[0].Id;
        }
    }

    // Always returns all 7 days, filling in a 09:00–18:00 default for any day not yet configured.
    private static List<BusinessHours> BuildWeekRows(ICollection<BusinessHours> existing) =>
        WeekOrder.Select(day => existing.FirstOrDefault(h => h.DayOfWeek == day) is { } found
            ? new BusinessHours { DayOfWeek = day, BusinessId = found.BusinessId, IsClosed = found.IsClosed, OpenTime = found.OpenTime, CloseTime = found.CloseTime }
            : new BusinessHours { DayOfWeek = day, BusinessId = Guid.Empty, IsClosed = false, OpenTime = new TimeOnly(9, 0), CloseTime = new TimeOnly(18, 0) })
            .ToList();

    private async Task SaveHoursAsync()
    {
        _hoursError = null;
        _hoursSavedMessage = null;

        var incomplete = _hoursRows.FirstOrDefault(r => !r.IsClosed && (r.OpenTime is null || r.CloseTime is null));
        if (incomplete is not null)
        {
            _hoursError = $"Set both an open and close time for {incomplete.DayOfWeek}, or mark it closed.";
            return;
        }

        _savingHours = true;
        var result = await BusinessController.SetHoursAsync(Id!.Value, _hoursRows);
        _savingHours = false;

        if (result is UnauthorizedResult)
        {
            _hoursError = "You don't have permission to edit this business's hours.";
            return;
        }

        _hoursSavedMessage = "Hours saved.";
    }

    private async Task AddClosureAsync()
    {
        _closureError = null;

        if (_closureStart is null || _closureEnd is null)
        {
            _closureError = "Pick a start and end date.";
            return;
        }

        if (_closureEnd < _closureStart)
        {
            _closureError = "End date must be on or after the start date.";
            return;
        }

        _addingClosure = true;
        var result = await BusinessController.AddClosureAsync(Id!.Value, _closureStart.Value, _closureEnd.Value, _closureReason);
        _addingClosure = false;

        if (result.Result is UnauthorizedResult)
        {
            _closureError = "You don't have permission to edit this business's closures.";
            return;
        }

        if (result.Value is { } closure)
        {
            _closures.Add(closure);
            _closures = _closures.OrderBy(c => c.StartDate).ToList();
            _closureStart = null;
            _closureEnd = null;
            _closureReason = null;
        }
    }

    private async Task ConfirmRemoveClosureAsync()
    {
        if (_pendingRemoveClosure is not { } closure)
            return;

        _removingClosure = true;
        var result = await BusinessController.RemoveClosureAsync(Id!.Value, closure.Id);
        _removingClosure = false;

        if (result is NoContentResult)
            _closures.RemoveAll(c => c.Id == closure.Id);

        _pendingRemoveClosure = null;
    }

    private async Task OnImageSelectedAsync(InputFileChangeEventArgs e)
    {
        _imageUploadError = null;

        if (e.File.Size > ImageUpload.MaxSizeBytes)
        {
            _imageUploadError = $"Image is too large — max {ImageUpload.MaxSizeBytes / 1024 / 1024} MB.";
            return;
        }

        _uploadingImage = true;
        try
        {
            await using var stream = e.File.OpenReadStream(ImageUpload.MaxSizeBytes);
            _model.ImageUrl = await ImageUploadService.SaveAsync(stream, e.File.Name, "businesses");
        }
        catch (InvalidOperationException ex)
        {
            _imageUploadError = ex.Message;
        }
        catch (IOException)
        {
            _imageUploadError = $"Image is too large — max {ImageUpload.MaxSizeBytes / 1024 / 1024} MB.";
        }
        finally
        {
            _uploadingImage = false;
        }
    }

    private async Task Submit()
    {
        if (IsEdit)
        {
            var business = new Business
            {
                Id = Id!.Value,
                Name = _model.Name!,
                Description = _model.Description!,
                Address = _model.Address!,
                ImageUrl = _model.ImageUrl,
                Latitude = _model.Latitude,
                Longitude = _model.Longitude,
                BusinessTypeId = _model.BusinessTypeId
            };
            await BusinessController.UpdateAsync(business);
        }
        else
        {
            var business = new Business
            {
                Name = _model.Name!,
                Description = _model.Description!,
                Address = _model.Address!,
                ImageUrl = _model.ImageUrl,
                Latitude = _model.Latitude,
                Longitude = _model.Longitude,
                BusinessTypeId = _model.BusinessTypeId
            };
            await BusinessController.AddAsync(business);
        }

        NavigationManager.NavigateTo("/businesses");
    }

    private async Task UseCurrentLocationAsync()
    {
        _locationError = null;
        _locating = true;
        try
        {
            var position = await JSRuntime.InvokeAsync<GeoPosition?>("EcoMeal.geo.getPosition");
            if (position is null)
            {
                _locationError = "Couldn't get your location — check your browser's location permission.";
                return;
            }

            _model.Latitude = position.Lat;
            _model.Longitude = position.Lng;
        }
        catch
        {
            _locationError = "Couldn't get your location — check your browser's location permission.";
        }
        finally
        {
            _locating = false;
        }
    }

    private class GeoPosition
    {
        public double Lat { get; set; }
        public double Lng { get; set; }
    }

    private class BusinessFormModel
    {
        [Required(ErrorMessage = "Enter a business name.")]
        public string? Name { get; set; }

        [Required(ErrorMessage = "Enter a short description.")]
        public string? Description { get; set; }

        [Required(ErrorMessage = "Enter an address.")]
        public string? Address { get; set; }

        public string? ImageUrl { get; set; }

        [Range(-90, 90, ErrorMessage = "Latitude must be between -90 and 90.")]
        public double? Latitude { get; set; }

        [Range(-180, 180, ErrorMessage = "Longitude must be between -180 and 180.")]
        public double? Longitude { get; set; }

        public Guid BusinessTypeId { get; set; }
    }
}