@page "/payments"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Mvc
@using Netrom_Eco_Meal.Constants
@using Netrom_Eco_Meal.Controllers
@using Netrom_Eco_Meal.Entities
@using Netrom_Eco_Meal.Models
@using Netrom_Eco_Meal.Services
@using Netrom_Eco_Meal.Services.Interfaces
@rendermode InteractiveServer
@implements IDisposable
@inject OrderController OrderController
@inject IBusinessService BusinessService
@inject AuthenticationStateProvider AuthStateProvider
@inject ManagedBusinessContext ManagedBusinessContext
@attribute [Authorize(Roles = $"{AppRoles.Admin},{AppRoles.BusinessManager}")]

<PageTitle>Payments — Eco Meal</PageTitle>

@if (_forbidden)
{
    <ForbiddenPanel Message="@_forbiddenReason" BackHref="/dashboard" BackLabel="Back to dashboard"/>
    return;
}

<div class="mb-4">
    <h1 class="h3 fw-bold mb-1">Payments</h1>
    <p class="text-muted small mb-0">@(_isAdmin ? "Every payment collected across all businesses" : "Payments collected at your business")</p>
</div>

@if (_paged is not null)
{
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 card-accent-green">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-success bg-opacity-10 text-success">
                        <i class="bi bi-cash-stack fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Collected (this page)</div>
                        <div class="fw-bold fs-5">@_collectedThisPage.ToString("C")</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 card-accent-amber">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-secondary bg-opacity-10 text-secondary">
                        <i class="bi bi-arrow-counterclockwise fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Refunded (this page)</div>
                        <div class="fw-bold fs-5">@_refundedThisPage.ToString("C")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex gap-3 mb-3 flex-wrap">
        @if (_isAdmin)
        {
            <select class="form-select" style="max-width: 220px;" @bind="_businessFilter" @bind:after="FilterChangedAsync">
                <option value="">All businesses</option>
                @foreach (var b in _allBusinesses)
                {
                    <option value="@b.Id">@b.Name</option>
                }
            </select>
        }
        <span class="align-self-center text-muted small ms-auto">@_paged.TotalCount order@(_paged.TotalCount == 1 ? "" : "s")</span>
    </div>
}

<div class="card border-0 shadow-sm">
    @if (_paged is null)
    {
        <div class="d-flex justify-content-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (_paged.Items.Count == 0)
    {
        <div class="text-center py-5">
            <i class="bi bi-credit-card fs-1 text-muted d-block mb-3"></i>
            <p class="text-muted mb-0">No orders have been placed yet.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead>
                <tr class="border-bottom">
                    <th class="px-4 py-3 text-uppercase text-muted small fw-semibold">Order</th>
                    @if (_isAdmin)
                    {
                        <th class="py-3 text-uppercase text-muted small fw-semibold">Business</th>
                    }
                    <th class="py-3 text-uppercase text-muted small fw-semibold">Customer</th>
                    <th class="py-3 text-uppercase text-muted small fw-semibold">Amount</th>
                    <th class="py-3 text-uppercase text-muted small fw-semibold">Payment</th>
                    <th class="py-3 text-uppercase text-muted small fw-semibold">Paid</th>
                    <th class="py-3 text-uppercase text-muted small fw-semibold">Refunded</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var order in _paged.Items)
                {
                    <tr>
                        <td class="px-4 fw-semibold">#@order.OrderNumber.ToString("000")</td>
                        @if (_isAdmin)
                        {
                            <td>@order.Business.Name</td>
                        }
                        <td>@order.User.Name</td>
                        <td class="fw-semibold">@(order.Payment is null ? "—" : order.Payment.Amount.ToString("C"))</td>
                        <td>
                            @if (order.Payment is null)
                            {
                                <span class="badge bg-warning-subtle text-warning">Unpaid</span>
                            }
                            else
                            {
                                <span class="badge @(order.Payment.Status == PaymentStatuses.Refunded ? "bg-secondary-subtle text-secondary" : "bg-success-subtle text-success")">
                                    @(order.Payment.Status == PaymentStatuses.Refunded ? "Refunded" : "Paid")
                                </span>
                            }
                        </td>
                        <td class="text-muted small">@(order.Payment is null ? "—" : order.Payment.CreatedAt.ToLocalTime().ToString("MMM d, HH:mm"))</td>
                        <td class="text-muted small">@(order.Payment?.RefundedAt is null ? "—" : order.Payment.RefundedAt.Value.ToLocalTime().ToString("MMM d, HH:mm"))</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <Pagination CurrentPage="_paged.PageIndex" TotalPages="_paged.TotalPages" OnPageChange="PageChangedAsync" />
    }
</div>

@code {
    private PaginatedList<Order>? _paged;
    private List<Business> _allBusinesses = [];
    private string _businessFilter = "";
    private bool _isAdmin;
    private bool _forbidden;
    private string _forbiddenReason = "";
    private int _pageIndex = 1;
    private const int PageSize = 15;
    private readonly Debouncer _reloadGate = new();

    private decimal _collectedThisPage;
    private decimal _refundedThisPage;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _isAdmin = authState.User.IsInRole(AppRoles.Admin);

        if (_isAdmin)
            _allBusinesses = (await BusinessService.GetAllAsync()).OrderBy(b => b.Name).ToList();
        else
            await ManagedBusinessContext.EnsureLoadedAsync();

        await LoadPageAsync();

        if (_forbidden)
            return;

        ManagedBusinessContext.OnChange += HandleManagedBusinessChanged;
    }

    private async Task LoadPageAsync()
    {
        Guid? businessId = _isAdmin
            ? (Guid.TryParse(_businessFilter, out var bId) ? bId : null)
            : ManagedBusinessContext.SelectedBusinessId;
        var result = await OrderController.GetOrdersForManagementPagedAsync(_pageIndex, PageSize, null, businessId, null);
        if (result.Result is UnauthorizedResult)
        {
            _forbidden = true;
            _forbiddenReason = "You don't manage a business yet, so there are no payments to show.";
            return;
        }

        _paged = result.Value;
        _collectedThisPage = _paged?.Items.Where(o => o.Payment is not null).Sum(o => o.Payment!.Amount) ?? 0m;
        _refundedThisPage = _paged?.Items.Where(o => o.Payment?.Status == PaymentStatuses.Refunded).Sum(o => o.Payment!.Amount) ?? 0m;
    }

    private async void HandleManagedBusinessChanged()
    {
        _pageIndex = 1;
        await InvokeAsync(async () =>
        {
            await LoadPageAsync();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        ManagedBusinessContext.OnChange -= HandleManagedBusinessChanged;
    }

    private Task ReloadAsync() => _reloadGate.DebounceAsync(LoadPageAsync);

    private Task FilterChangedAsync()
    {
        _pageIndex = 1;
        return ReloadAsync();
    }

    private Task PageChangedAsync(int page)
    {
        _pageIndex = page;
        return ReloadAsync();
    }
}
