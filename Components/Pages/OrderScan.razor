@page "/orders/scan"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Mvc
@using Netrom_Eco_Meal.Constants
@using Netrom_Eco_Meal.Controllers
@using Netrom_Eco_Meal.Entities
@using Netrom_Eco_Meal.Services
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime
@inject OrderController OrderController
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@inject ManagedBusinessContext ManagedBusinessContext
@attribute [Authorize(Roles = $"{AppRoles.Admin},{AppRoles.BusinessManager}")]

<PageTitle>Scan pickup — Eco Meal</PageTitle>

<div class="scan-page">
    <div class="scan-header">
        <h1 class="h4 fw-bold mb-1">Scan pickup QR code</h1>
        <p class="scan-hint">Point the camera at the customer's pickup pass to bring up their order.</p>
    </div>

    @if (_cameraError is not null)
    {
        <div class="alert alert-danger" role="alert">@_cameraError</div>
    }

    <div class="scan-viewfinder">
        <video @ref="_videoElement" autoplay playsinline muted></video>
        <canvas @ref="_canvasElement" hidden></canvas>

        @if (_scanning)
        {
            <div class="scan-frame-guide" aria-hidden="true">
                <span class="scan-corner scan-corner-tl"></span>
                <span class="scan-corner scan-corner-tr"></span>
                <span class="scan-corner scan-corner-bl"></span>
                <span class="scan-corner scan-corner-br"></span>
            </div>
        }
        else
        {
            <div class="scan-idle-overlay">
                <button type="button" class="btn btn-primary px-4" disabled="@_starting" @onclick="StartScanningAsync">
                    @if (_starting)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                    }
                    <i class="bi bi-camera-fill me-1"></i> Start scanning
                </button>
            </div>
        }
    </div>

    <div class="scan-manual">
        <p class="scan-manual-label">No camera, or the code won't scan? Look the order up instead:</p>
        <div class="scan-manual-form">
            <input type="text" class="form-control" placeholder="Order number, e.g. 021"
                   @bind="_manualSearch" @bind:event="oninput" @onkeydown="OnManualKeyDownAsync"/>
            <button type="button" class="btn btn-outline-primary" disabled="@(_manualBusy || string.IsNullOrWhiteSpace(_manualSearch))" @onclick="ManualLookupAsync">
                @if (_manualBusy)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                }
                Find order
            </button>
        </div>

        @if (_manualError is not null)
        {
            <div class="alert alert-danger py-2 small mt-2" role="alert">@_manualError</div>
        }

        @if (_manualMatches is { Count: > 0 })
        {
            <ul class="scan-manual-results">
                @foreach (var order in _manualMatches)
                {
                    <li>
                        <span>Order #@order.OrderNumber.ToString("000") — @order.User.Name (@order.Business.Name)</span>
                        @if (order.PickupPasses.Count == 1)
                        {
                            <a class="btn btn-sm btn-primary" href="/orders/validate/@order.Id/@order.PickupPasses.First().Id">Confirm pickup</a>
                        }
                        else
                        {
                            <div class="scan-manual-pass-picker">
                                @foreach (var pass in order.PickupPasses.OrderBy(p => p.CreatedAt))
                                {
                                    <a class="btn btn-sm btn-outline-primary" href="/orders/validate/@order.Id/@pass.Id">@pass.Label</a>
                                }
                            </div>
                        }
                    </li>
                }
            </ul>
        }
    </div>

    <a href="/orders/manage" class="biz-page-back scan-back-link"><i class="bi bi-arrow-left"></i> Back to order management</a>
</div>

@code {
    private ElementReference _videoElement;
    private ElementReference _canvasElement;
    private IJSObjectReference? _module;
    private bool _scanning;
    private bool _starting;
    private string? _cameraError;

    private bool _isAdmin;
    private string _manualSearch = "";
    private bool _manualBusy;
    private string? _manualError;
    private List<Order>? _manualMatches;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _isAdmin = authState.User.IsInRole(AppRoles.Admin);

        if (!_isAdmin)
            await ManagedBusinessContext.EnsureLoadedAsync();
    }

    private Task OnManualKeyDownAsync(KeyboardEventArgs e) =>
        e.Key == "Enter" ? ManualLookupAsync() : Task.CompletedTask;

    private async Task ManualLookupAsync()
    {
        if (string.IsNullOrWhiteSpace(_manualSearch) || _manualBusy)
            return;

        _manualBusy = true;
        _manualError = null;
        _manualMatches = null;

        // Admin searches every business; a manager is scoped to whichever one they've currently
        // selected in the sidebar switcher (same rule /orders/manage and /payments use) — passing
        // null for a manager isn't "search all mine", it's rejected outright, see
        // OrderService.ResolveManagerBusinessIdAsync.
        Guid? businessId = _isAdmin ? null : ManagedBusinessContext.SelectedBusinessId;

        // Only Confirmed orders have a live, unredeemed pickup pass to confirm — matches what
        // scanning a real QR code would land on (see OrderPickupPass.RedeemedAt's own comment).
        var result = await OrderController.GetOrdersForManagementPagedAsync(1, 5, _manualSearch.Trim(), businessId, OrderStatuses.Confirmed);
        _manualBusy = false;

        if (result.Result is UnauthorizedResult)
        {
            _manualError = "You don't manage a business yet, so there's nothing to look up.";
            return;
        }

        var matches = result.Value?.Items ?? [];
        if (matches.Count == 0)
        {
            _manualError = "No confirmed order matches that number — check it hasn't already been picked up, or that it's been confirmed yet.";
            return;
        }

        _manualMatches = matches;
    }

    // Camera init must be gated behind an explicit tap rather than firing on render — required
    // for reliable behavior on iOS Safari, and avoids prompting for camera permission before the
    // page has even finished settling its [Authorize] redirect chain.
    private async Task StartScanningAsync()
    {
        _starting = true;
        _cameraError = null;

        try
        {
            // Co-located JS module (Blazor JS isolation) — the entire capture/decode loop runs
            // client-side with zero per-frame interop; a successful decode does a real browser
            // navigation, it never calls back into C#.
            _module ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./Components/Pages/OrderScan.razor.js");
            await _module.InvokeVoidAsync("startCamera", _videoElement, _canvasElement);
            _scanning = true;
        }
        catch (JSException ex)
        {
            _cameraError = ex.Message.Contains("Permission", StringComparison.OrdinalIgnoreCase) ||
                            ex.Message.Contains("NotAllowedError", StringComparison.OrdinalIgnoreCase)
                ? "Camera access was denied. Allow camera access for this site in your browser settings and try again."
                : "Couldn't start the camera. Make sure this device has one and try again.";
        }

        _starting = false;
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is null)
            return;

        try
        {
            // Always stop the camera track on the way out — otherwise the OS camera-in-use
            // indicator stays lit even after leaving this page.
            await _module.InvokeVoidAsync("stopCamera");
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // Circuit already gone (tab closed / navigated away) — nothing left to clean up client-side.
        }
    }
}
