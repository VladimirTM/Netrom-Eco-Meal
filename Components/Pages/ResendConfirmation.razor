@page "/account/resend-confirmation"
@layout EmptyLayout
@rendermode InteractiveServer
@using Netrom_Eco_Meal.Controllers
@inject AuthController AuthController

<PageTitle>Resend confirmation email — Eco Meal</PageTitle>

<div class="login-page">
    <div class="login-card">
        <div class="login-brand">
            <img src="logo.png" alt="Eco Meal" class="login-logo"/>
            <div>
                <div class="login-brand-name">Eco Meal</div>
                <div class="login-brand-sub">Surplus food, rescued</div>
            </div>
        </div>

        <h1 class="login-heading">Resend confirmation email</h1>

        @if (_submitted)
        {
            <div class="alert alert-success py-2 small mb-3" role="alert">
                If an unconfirmed account exists for that email, we've sent a fresh confirmation link.
            </div>
        }
        else
        {
            <p class="text-muted small mb-3">Lost the email, or the link expired? Enter your account email and we'll send a new one.</p>
            <div class="mb-4">
                <label class="form-label fw-semibold" for="resend-email">Email</label>
                <input id="resend-email" class="form-control" type="email" @bind="_email"
                       placeholder="you@example.com" autocomplete="email"/>
            </div>
            <button class="btn btn-primary w-100 py-2 fw-semibold" disabled="@_busy" @onclick="SubmitAsync">
                @(_busy ? "Sending…" : "Resend confirmation email")
            </button>
        }

        <p class="login-footer-link">
            <a href="/account/login">Back to sign in</a>
        </p>
    </div>
</div>

@code {
    private string _email = "";
    private bool _busy;
    private bool _submitted;

    private async Task SubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(_email))
            return;

        _busy = true;
        await AuthController.ResendConfirmationEmailAsync(_email.Trim());
        _busy = false;
        _submitted = true;
    }
}
